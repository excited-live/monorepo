# Better Auth (docs/plan-auth-migration.md). Staging values live in GitHub repo
# secrets / your local .env only. NEVER commit .env.
# Min 32 chars. Generate with: openssl rand -base64 32
# Required: `pnpm dev` refuses to start without it. There is no built-in
# fallback secret, on purpose.
BETTER_AUTH_SECRET=
# The public origin of this API — the OAuth provider derives its issuer from
# it. Optional in dev (falls back to the request origin); set it in production.
BETTER_AUTH_URL=
# Optional Google social login; auth works without them (email/password only)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated extra origins allowed to call the auth endpoints cross-origin
# (mobile app origins, webapp origin).
BETTER_AUTH_TRUSTED_ORIGINS=
# Webapp origin that hosts the MCP authorization server (<origin>/api/auth).
# When set, /mcp also accepts OAuth JWT access tokens and serves RFC 9728
# protected-resource metadata. Leave unset to keep the API-keys/sessions-only
# behaviour. The webapp side needs EXCITED_API_URL pointing back at this API.
EXCITED_WEBAPP_URL=
