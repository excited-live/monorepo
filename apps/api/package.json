{
	"name": "@excited-live/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:api": "tsx watch src/index.ts",
		"build": "tsup src/index.ts src/worker.ts --format esm --clean",
		"start": "node dist/index.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"gen:migrations": "tsx scripts/gen-migrations.ts",
		"proof:persistence": "bash scripts/persistence-proof.sh",
		"lint": "eslint ."
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"dependencies": {
		"@excited-live/auth": "workspace:*",
		"@excited-live/biz": "workspace:*",
		"@excited-live/sim": "workspace:*",
		"@excited-live/tax": "workspace:*",
		"@hono/node-server": "^1.13.8",
		"hono": "^4.7.4"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsup": "^8.5.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"vitest": "^3.2.0"
	}
}
