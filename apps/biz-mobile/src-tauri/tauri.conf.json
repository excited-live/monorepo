{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "excited.live",
	"version": "0.0.1",
	"identifier": "live.excited.mobile",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1430",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "excited.live",
				"width": 420,
				"height": 840,
				"resizable": true,
				"backgroundColor": "#F3F0EE"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png"
		]
	}
}
