{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"vite/client"
		],
		"baseUrl": ".",
		"paths": {
			"~/*": [
				"./src/*"
			],
			"@excited-live/api/client": [
				"../api/src/client.ts"
			],
			"@excited-live/api": [
				"../api/src/index.ts"
			]
		},
		"noUncheckedIndexedAccess": true
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
