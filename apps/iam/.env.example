# apps/iam — build-time configuration (Vite inlines VITE_* at build).
#
# Everything here is public: these values end up in the JS bundle. No secrets.
# Copy to `.env.local` for local development.

# The single API origin. Browser requests go here directly — no BFF.
# Local: the apps/api dev server (port 8000 by default).
VITE_API_URL=http://localhost:8000

# The OAuth authorization server (consent + device-code approval pages).
# It is the webapp's Better Auth cookies mount; iam only resumes flows there.
# Leave empty in local dev to use the API's tokens mount for everything.
VITE_AUTH_SERVER_URL=

# Public label in the topbar: local | prelive | production.
VITE_ENV_LABEL=local

# MCP endpoint shown in the config generator. Defaults to <VITE_API_URL>/mcp.
VITE_MCP_URL=
