# Static security headers for the landing page (served by Cloudflare Pages).
# Mirrors the baseline used by the other excited.live apps.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The machine-readable cost answer (#192). Pages infers text/markdown from the
# extension; pin it so charset is guaranteed for agents that sniff.
/pricing.md
  Content-Type: text/markdown; charset=utf-8
