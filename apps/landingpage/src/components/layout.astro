---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** 1200x630 social preview image — path or absolute URL. Defaults to /og.png. */
	ogImage?: string;
	ogType?: 'website' | 'article';
	/** Extra JSON-LD node(s) appended to the sitewide schema graph. */
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'excited.live — Know your runway across every project',
	description =
		'A free Android app that shows how long your cash lasts across your day job, side projects and every business, in one place. Join the waitlist.',
	ogImage = '/og.png',
	ogType = 'website',
	schema,
} = Astro.props;

const site = Astro.site ?? new URL('https://excited.live');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

const orgId = new URL('/#org', site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': orgId,
			name: 'FromSukong',
			url: 'https://fromsukong.com',
			logo: new URL('/logo-mark.png', site).href,
			sameAs: [
				'https://www.instagram.com/excited.live/',
				'https://github.com/fromsukong/excited.live',
			],
		},
		{
			'@type': 'WebSite',
			'@id': new URL('/#website', site).href,
			name: 'excited.live',
			url: new URL('/', site).href,
			description,
			publisher: { '@id': orgId },
			inLanguage: ['en', 'th'],
		},
		...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
	],
};
---

<!doctype html>
<html lang="en" data-theme="light" data-lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="excited.live" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="theme-color" content="#F3F0EE" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sofia+Sans:wght@400;450;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline>
			// Google Analytics 4 — production hostname only, and only after the
			// visitor accepts the cookie banner (choice stored as `exl-consent`).
			// page_view is counted per route because ClientRouter serves
			// client-side navigations.
			(() => {
				if (location.hostname !== 'excited.live') return;
				const CONSENT_KEY = 'exl-consent';
				const GA_ID = 'G-QFCM071TWH';
				const readConsent = () => {
					try {
						return localStorage.getItem(CONSENT_KEY) ?? window.__exlConsentChoice ?? null;
					} catch {
						return window.__exlConsentChoice ?? null;
					}
				};
				let sentFor = null;
				const pageview = () => {
					if (sentFor === location.href) return;
					sentFor = location.href;
					window.gtag('event', 'page_view', {
						page_location: location.href,
						page_title: document.title,
					});
				};
				const loadGa = () => {
					if (window.__exlGaInit) return;
					window.__exlGaInit = true;
					window.dataLayer = window.dataLayer || [];
					window.gtag = function (...args) {
						window.dataLayer.push(args);
					};
					window.gtag('js', new Date());
					window.gtag('config', GA_ID, { send_page_view: false });
					const s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
					document.head.appendChild(s);
					document.addEventListener('astro:page-load', pageview);
					pageview();
				};
				// The consent banner (end of <body>) calls this after 'Accept'.
				window.__exlGaLoad = loadGa;
				if (readConsent() === 'granted') loadGa();
			})();
		</script>
		<script is:inline>
			// Restore language before first paint (EN first per repo rule).
			(() => {
				try {
					const saved = localStorage.getItem('exl-lang');
					document.documentElement.dataset.lang =
						saved === 'th' || saved === 'en' ? saved : 'en';
				} catch {
					document.documentElement.dataset.lang = 'en';
				}
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />

		<!-- Cookie consent — GA (head script) only initializes after Accept. -->
		<div id="cookie-banner" class="cookie-banner" hidden>
			<p class="cookie-text">
				<span data-lang-en>
					We collect some usage data to improve our service. No ads, no selling
					your data.
				</span>
				<span data-lang-th>
					เราเก็บข้อมูลการใช้งานเพื่อพัฒนาบริการให้ดีขึ้น — ไม่มีโฆษณา ไม่ขายข้อมูล
				</span>
				<a class="cookie-learn" href="/docs/privacy">
					<span data-lang-en>Privacy</span>
					<span data-lang-th>ความเป็นส่วนตัว</span>
				</a>
			</p>
			<div class="cookie-actions">
				<button type="button" class="cookie-btn" data-consent="denied">
					<span data-lang-en>Decline</span>
					<span data-lang-th>ปฏิเสธ</span>
				</button>
				<button type="button" class="cookie-btn cookie-btn--accept" data-consent="granted">
					<span data-lang-en>Accept</span>
					<span data-lang-th>ยอมรับ</span>
				</button>
			</div>
		</div>

		<script is:inline>
			// Cookie consent banner. Stores Accept/Decline in localStorage
			// (`exl-consent`); the GA head script only initializes after Accept.
			// Re-synced on astro:page-load because ClientRouter swaps the body.
			(() => {
				const KEY = 'exl-consent';
				const read = () => {
					try {
						return localStorage.getItem(KEY) ?? window.__exlConsentChoice ?? null;
					} catch {
						return window.__exlConsentChoice ?? null;
					}
				};
				const sync = () => {
					const el = document.getElementById('cookie-banner');
					if (el) el.hidden = read() !== null;
				};
				document.addEventListener('click', (event) => {
					const target = event.target;
					if (!target || !target.closest) return;
					const choice = target.closest('[data-consent]');
					if (choice) {
						const value = choice.getAttribute('data-consent');
						window.__exlConsentChoice = value;
						try {
							localStorage.setItem(KEY, value);
						} catch {
							/* storage unavailable — choice lasts this page view */
						}
						if (value === 'granted' && window.__exlGaLoad) window.__exlGaLoad();
						sync();
						return;
					}
					if (target.closest('[data-consent-reset]')) {
						event.preventDefault();
						window.__exlConsentChoice = null;
						try {
							localStorage.removeItem(KEY);
						} catch {
							/* ignore */
						}
						sync();
					}
				});
				document.addEventListener('astro:page-load', sync);
				sync();
			})();
		</script>
	</body>
</html>

<style>
	.cookie-banner {
		position: fixed;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 80;
		width: min(640px, calc(100vw - 24px));
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 12px 12px 18px;
		background: var(--lifted);
		border: 1px solid var(--dust);
		border-radius: 18px;
		box-shadow: var(--shadow-halo);
	}
	.cookie-banner[hidden] {
		display: none;
	}
	.cookie-text {
		flex: 1;
		margin: 0;
		font-size: 13.5px;
		line-height: 1.45;
		color: var(--charcoal);
	}
	.cookie-learn {
		color: var(--link-blue);
		margin-left: 4px;
		white-space: nowrap;
	}
	.cookie-actions {
		display: flex;
		gap: 8px;
		flex-shrink: 0;
	}
	.cookie-btn {
		appearance: none;
		background: transparent;
		border: 1px solid var(--dust);
		color: var(--ink);
		font: inherit;
		font-size: 13.5px;
		font-weight: 600;
		padding: 8px 16px;
		border-radius: 999px;
		cursor: pointer;
	}
	.cookie-btn--accept {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--canvas);
	}
	.cookie-btn:hover {
		opacity: 0.85;
	}
	@media (max-width: 620px) {
		.cookie-banner {
			flex-direction: column;
			align-items: stretch;
			padding: 16px;
		}
		.cookie-actions {
			justify-content: flex-end;
		}
	}
</style>
