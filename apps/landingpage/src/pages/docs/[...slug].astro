---
import { render } from 'astro:content';
import { Docs } from '@/components/docs';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import '@/styles/global.css';
import { getPageImageUrl, source } from '@/lib/source';
import Layout from '@/components/layout.astro';
import type { TOCItemType } from 'fumadocs-core/toc';

export async function getStaticPaths() {
	return source.getPages().map((page) => ({
		params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
		props: { page: page.data._raw },
	}));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs = typeof Astro.params.slug === 'string' ? Astro.params.slug.split('/') : [];
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage);
// #197 R3: `hreflang` may only be claimed by a page that really carries both
// languages. A page that declares a Thai title (`titleTh`, the field the docs
// translation uses) has a Thai body too; anything else is English and stays
// silent, so no page advertises a translation it does not have. Read
// defensively because the field lands with that translation, not before it.
const hasThai = Boolean((page.data as { titleTh?: string }).titleTh);
const bilingual = hasThai;
// Brand suffix, unless the title already carries the name (docs index).
const pageTitle = page.data.title.includes('excited.live')
	? page.data.title
	: `${page.data.title} — excited.live`;

const toc: TOCItemType[] = headings.map((heading) => ({
	depth: heading.depth,
	title: heading.text,
	url: '#' + heading.slug,
}));
---

<Layout title={pageTitle} description={page.data.description} ogImage={image} bilingual={bilingual}>
	<Docs
		tree={source.getPageTree()}
		pathname={Astro.url.pathname}
		params={Astro.params}
		page={{ toc }}
		client:load
	>
		<h1 class="font-semibold text-3xl">{page.data.title}</h1>
		<p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
		<div class="prose flex-1">
			<Content components={{ ...defaultMdxComponents }} />
		</div>
	</Docs>
</Layout>
