        <script is:inline>
          (function () {
            var section = document.querySelector('[data-od-id="dir-b-final-cta"]');
            if (!section) return;
            var promptEl = section.querySelector('#b-footer-prompt');
            var fallbackEl = section.querySelector('.copy-fallback-area');
            var metaEn = section.querySelector('#b-cta-meta-en');
            var metaTh = section.querySelector('#b-cta-meta-th');
            var copyBtn = section.querySelector('[data-copy-target="b-footer-prompt"]');
            var inputs = section.querySelectorAll('.b-pick');
            var currentAuthState = 'guest';
            var setupsGuest = {
              'claude-code': {
                prompt: 'Add excited.live to Claude Code:\n\nclaude mcp add --scope user --transport http excited https://mcp.excited.live/mcp\n\nThen use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'Claude Code · CLI (Public)',
                th: 'Claude Code · CLI (สาธารณะ)'
              },
              codex: {
                prompt: 'Add excited.live to Codex:\n\ncodex mcp add excited --url https://mcp.excited.live/mcp\n\nThen use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'Codex · CLI (Public)',
                th: 'Codex · CLI (สาธารณะ)'
              },
              cursor: {
                prompt: 'Add excited.live to Cursor:\n\nIn ~/.cursor/mcp.json, add:\n{\n  "mcpServers": {\n    "excited": { "url": "https://mcp.excited.live/mcp" }\n  }\n}\n\nRestart Cursor, then use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'Cursor · mcp.json (Public)',
                th: 'Cursor · ไฟล์ mcp.json (สาธารณะ)'
              },
              claude: {
                prompt: 'Add excited.live to Claude:\n\nCustomize → Connectors → Add custom connector → Web:\nhttps://mcp.excited.live/mcp\n\nThen use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'Claude · custom connector (Public)',
                th: 'Claude · คอนเนกเตอร์กำหนดเอง (สาธารณะ)'
              },
              chatgpt: {
                prompt: 'Add excited.live to ChatGPT:\n\nTurn on Developer mode in Settings → Apps → Advanced settings.\nThen add a custom MCP connector at\nhttps://mcp.excited.live/mcp\n\nThen use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'ChatGPT · developer mode (Public)',
                th: 'ChatGPT · โหมดนักพัฒนา (สาธารณะ)'
              },
              any: {
                prompt: 'Add excited.live to your MCP client at https://mcp.excited.live/mcp\n\nThen use the onboard_me prompt and follow its guide. Sign me in and talk to me in English.',
                en: 'Any MCP client · streamable HTTP',
                th: 'ไคลเอนต์ MCP อื่น ๆ · streamable HTTP'
              }
            };
            var setupsUser = {
              'claude-code': {
                prompt: 'Add excited.live to Claude Code (authenticated):\n\nclaude mcp add --scope user --transport http --header "Authorization: Bearer ex_live_79a4e2bc81d" excited https://mcp.excited.live/mcp\n\nThen prompt: "Run read_runway for my projects and report my burn rate."',
                en: 'Claude Code · CLI (Session Injected 🟢)',
                th: 'Claude Code · CLI (ใส่โทเค็นแล้ว 🟢)'
              },
              codex: {
                prompt: 'Add excited.live to Codex (authenticated):\n\ncodex mcp add excited --url https://mcp.excited.live/mcp --header "Authorization: Bearer ex_live_79a4e2bc81d"\n\nThen prompt: "Run simulate_scenario for zero revenue in Q2."',
                en: 'Codex · CLI (Session Injected 🟢)',
                th: 'Codex · CLI (ใส่โทเค็นแล้ว 🟢)'
              },
              cursor: {
                prompt: 'Add excited.live to Cursor (authenticated):\n\nIn ~/.cursor/mcp.json, add:\n{\n  "mcpServers": {\n    "excited": {\n      "url": "https://mcp.excited.live/mcp",\n      "headers": {\n        "Authorization": "Bearer ex_live_79a4e2bc81d"\n      }\n    }\n  }\n}\n\nRestart Cursor and ask: "Check my runway and tax plan for 2026."',
                en: 'Cursor · mcp.json (Session Injected 🟢)',
                th: 'Cursor · ไฟล์ mcp.json (ใส่โทเค็นแล้ว 🟢)'
              },
              claude: {
                prompt: 'Add excited.live to Claude (authenticated):\n\nCustomize → Connectors → Add custom connector → Web:\nURL: https://mcp.excited.live/mcp\nHeader: Authorization: Bearer ex_live_79a4e2bc81d\n\nThen ask Claude: "Show my cash balance across Mint Living and Bean Coffee."',
                en: 'Claude · custom connector (Session Injected 🟢)',
                th: 'Claude · คอนเนกเตอร์กำหนดเอง (ใส่โทเค็นแล้ว 🟢)'
              },
              chatgpt: {
                prompt: 'Add excited.live to ChatGPT (authenticated):\n\nTurn on Developer mode in Settings → Apps → Advanced settings.\nAdd MCP connector at https://mcp.excited.live/mcp with Bearer token ex_live_79a4e2bc81d.\n\nThen ask: "Run read_runway and summarize my burn rate."',
                en: 'ChatGPT · developer mode (Session Injected 🟢)',
                th: 'ChatGPT · โหมดนักพัฒนา (ใส่โทเค็นแล้ว 🟢)'
              },
              any: {
                prompt: 'Add excited.live to your MCP client:\n\nURL: https://mcp.excited.live/mcp\nHeader: Authorization: Bearer ex_live_79a4e2bc81d\n\nReady for tool calls (read_runway, simulate_scenario, log_expense).',
                en: 'Any MCP client · Streamable HTTP (Session Injected 🟢)',
                th: 'ไคลเอนต์ MCP อื่น ๆ · Streamable HTTP (ใส่โทเค็นแล้ว 🟢)'
              }
            };
            var hydrationBanner = section.querySelector('#b-auth-hydration-banner');
            function render(value) {
              var setups = (currentAuthState === 'user') ? setupsUser : setupsGuest;
              var setup = setups[value];
              if (!setup) return;
              promptEl.textContent = setup.prompt;
              if (fallbackEl) fallbackEl.value = setup.prompt;
              metaEn.textContent = setup.en;
              metaTh.textContent = setup.th;
              if (hydrationBanner) {
                hydrationBanner.style.display = (currentAuthState === 'user') ? 'inline-flex' : 'none';
              }
              if (copyBtn) {
                copyBtn.querySelectorAll('.copy-label-default').forEach(function (el) { el.style.display = ''; });
                copyBtn.querySelectorAll('.copy-label-done').forEach(function (el) { el.style.display = 'none'; });
              }
            }
            window.setLandingAuthState = function(state) {
              currentAuthState = state;
              var guestEl = document.getElementById('nav-state-guest');
              var userEl = document.getElementById('nav-state-user');
              var navAuthCta = document.getElementById('nav-auth-cta');
              var simBtns = document.querySelectorAll('.auth-sim-btn');
              if (navAuthCta) navAuthCta.setAttribute('data-auth-state', state);
              if (guestEl) guestEl.style.display = (state === 'user') ? 'none' : 'flex';
              if (userEl) userEl.style.display = (state === 'user') ? 'flex' : 'none';
              simBtns.forEach(function(b) {
                var isActive = (b.getAttribute('data-sim-auth') === state);
                b.classList.toggle('is-active', isActive);
                b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
              });
              var checked = section.querySelector('.b-pick:checked');
              render(checked ? checked.value : 'claude-code');
              try { localStorage.setItem('excited_auth_sim', state); } catch (e) {}
            };
            document.querySelectorAll('.auth-sim-btn').forEach(function(btn) {
              btn.addEventListener('click', function() {
                var targetState = btn.getAttribute('data-sim-auth');
                window.setLandingAuthState(targetState);
              });
            });
            Array.prototype.forEach.call(inputs, function (input) {
              input.addEventListener('change', function () {
                if (!input.checked) return;
                render(input.value);
                try { localStorage.setItem('b-cta-agent', input.value); } catch (err) {}
              });
            });
            var saved = null;
            try { saved = localStorage.getItem('b-cta-agent'); } catch (err) {}
            if (saved) {
              Array.prototype.forEach.call(inputs, function (input) {
                if (input.value === saved) input.checked = true;
              });
            }
            var savedAuth = null;
            try { savedAuth = localStorage.getItem('excited_auth_sim'); } catch (e) {}
            if (savedAuth && (savedAuth === 'user' || savedAuth === 'guest')) {
              window.setLandingAuthState(savedAuth);
            } else {
              var checked = section.querySelector('.b-pick:checked');
              render(checked ? checked.value : 'claude-code');
            }
          })();
        </script>
