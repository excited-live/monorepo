---
import Layout from '@/components/layout.astro';
import { SIGN_IN_URL, SIGN_UP_URL, MCP_URL } from '@/lib/hosts';
const MCP_DISPLAY = MCP_URL.replace(/^https?:\/\//, '');

const title = 'excited.live — Financial planning for solopreneurs, first jobber, AI native';
const description =
	'Tax, retirement, asset depreciation, investment tracking, and budgeting — built for your agent and for you.';

const appSchema = {
	'@type': 'SoftwareApplication',
	name: 'excited.live',
	description,
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Web, Android',
	inLanguage: ['en', 'th'],
	publisher: { '@id': 'https://excited.live/#org' },
};
---

<Layout title={title} description={description} schema={appSchema} bilingual>

  <!-- Official monochrome agent marks: Claude (Simple Icons), Cursor (Simple Icons), OpenAI (Wikimedia Commons), Model Context Protocol (Simple Icons). Licensed marks used nominatively to identify supported clients. -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;overflow:hidden;">
    <symbol id="mark-claude" viewBox="0 0 24 24"><path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"></path></symbol>
    <symbol id="mark-cursor" viewBox="0 0 24 24"><path d="M11.503.131 1.891 5.678a.84.84 0 0 0-.42.726v11.188c0 .3.162.575.42.724l9.609 5.55a1 1 0 0 0 .998 0l9.61-5.55a.84.84 0 0 0 .42-.724V6.404a.84.84 0 0 0-.42-.726L12.497.131a1.01 1.01 0 0 0-.996 0M2.657 6.338h18.55c.263 0 .43.287.297.515L12.23 22.918c-.062.107-.229.064-.229-.06V12.335a.59.59 0 0 0-.295-.51l-9.11-5.257c-.109-.063-.064-.23.061-.23"></path></symbol>
    <symbol id="mark-mcp" viewBox="0 0 24 24"><path d="M13.85 0a4.16 4.16 0 0 0-2.95 1.217L1.456 10.66a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l9.442-9.442a2.49 2.49 0 0 1 3.541 0 2.49 2.49 0 0 1 0 3.541L8.59 12.97l-.1.1a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l.1-.098 7.03-7.034a2.49 2.49 0 0 1 3.542 0l.049.05a2.49 2.49 0 0 1 0 3.54l-8.54 8.54a1.96 1.96 0 0 0 0 2.755l1.753 1.753a.835.835 0 0 0 1.18 0 .835.835 0 0 0 0-1.18l-1.753-1.753a.266.266 0 0 1 0-.394l8.54-8.54a4.185 4.185 0 0 0 0-5.9l-.05-.05a4.16 4.16 0 0 0-2.95-1.218c-.2 0-.401.02-.6.048a4.17 4.17 0 0 0-1.17-3.552A4.16 4.16 0 0 0 13.85 0m0 3.333a.84.84 0 0 0-.59.245L6.275 10.56a4.186 4.186 0 0 0 0 5.902 4.186 4.186 0 0 0 5.902 0L19.16 9.48a.835.835 0 0 0 0-1.18.835.835 0 0 0-1.18 0l-6.985 6.984a2.49 2.49 0 0 1-3.54 0 2.49 2.49 0 0 1 0-3.54l6.983-6.985a.835.835 0 0 0 0-1.18.84.84 0 0 0-.59-.245"></path></symbol>
    <symbol id="mark-openai" viewBox="1.68 1.75 16.65 16.5"><path d="M11.248 18.25q-.825 0-1.568-.314a4.3 4.3 0 0 1-1.32-.874 4 4 0 0 1-1.304.214 4 4 0 0 1-2.046-.544 4.27 4.27 0 0 1-1.518-1.485 4 4 0 0 1-.56-2.095q0-.48.131-1.04A4.4 4.4 0 0 1 2.04 10.71a4.07 4.07 0 0 1 .017-3.4 4.2 4.2 0 0 1 1.056-1.418 3.8 3.8 0 0 1 1.6-.842 3.9 3.9 0 0 1 .76-1.683q.593-.759 1.451-1.188a4.04 4.04 0 0 1 1.832-.429q.825 0 1.567.313.742.314 1.32.875a4 4 0 0 1 1.304-.215q1.106 0 2.046.545a4.14 4.14 0 0 1 1.501 1.485q.578.941.578 2.095 0 .48-.132 1.04.66.61 1.023 1.419.363.792.363 1.666 0 .892-.38 1.717a4.3 4.3 0 0 1-1.072 1.435 3.8 3.8 0 0 1-1.584.825 3.8 3.8 0 0 1-.775 1.683 4.06 4.06 0 0 1-1.436 1.188 4.04 4.04 0 0 1-1.832.429m-4.076-2.062q.825 0 1.435-.347l3.103-1.782a.36.36 0 0 0 .164-.313v-1.42L7.881 14.62a.67.67 0 0 1-.726 0l-3.118-1.798a.5.5 0 0 1-.017.115v.198q0 .841.396 1.551.413.693 1.139 1.089a3.2 3.2 0 0 0 1.617.412m.165-2.69a.4.4 0 0 0 .181.05q.083 0 .165-.05l1.238-.71-3.977-2.31a.7.7 0 0 1-.363-.643v-3.58q-.825.362-1.32 1.122a2.9 2.9 0 0 0-.495 1.65q0 .809.413 1.55.412.743 1.072 1.123zm3.91 3.663q.875 0 1.585-.396a2.96 2.96 0 0 0 1.534-2.64v-3.564a.32.32 0 0 0-.165-.297l-1.254-.726v4.604a.7.7 0 0 1-.363.643l-3.119 1.799a3 3 0 0 0 1.783.577m.627-6.039V8.878L10.01 7.822 8.129 8.878v2.244l1.881 1.056zM7.057 5.859a.7.7 0 0 1 .363-.644l3.119-1.798a3 3 0 0 0-1.782-.578q-.874 0-1.584.396A2.96 2.96 0 0 0 6.05 4.324a3.07 3.07 0 0 0-.396 1.551v3.547q0 .199.165.314l1.237.726zm8.383 7.887q.825-.364 1.303-1.123.495-.758.495-1.65a3.15 3.15 0 0 0-.412-1.55q-.413-.743-1.073-1.123l-3.086-1.782q-.099-.065-.181-.049a.3.3 0 0 0-.165.05l-1.238.692 3.993 2.327a.6.6 0 0 1 .264.264.64.64 0 0 1 .1.363zm-3.317-8.382a.63.63 0 0 1 .726 0l3.135 1.831v-.297q0-.792-.396-1.501a2.86 2.86 0 0 0-1.105-1.155q-.71-.43-1.65-.43-.825 0-1.436.347L8.294 5.941a.36.36 0 0 0-.165.314v1.418z"></path></symbol>
  </svg>
  <!-- Floating Pill Navigation with Split CTA -->
  <header class="nav-shell" id="site-nav" data-od-id="dir-b-nav">
    <nav class="nav-pill" aria-label="Primary navigation">
      <div class="nav-left">
        <a href="/" class="brand-link">
          <img src="/logo-mark.png" alt="excited.live" class="brand-mark" width="28" height="28" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
          <span class="brand-fallback" aria-hidden="true">ex</span>
          <span>excited.live</span>
        </a>
        
      </div>
      <ul class="nav-links">
        <li><a href="#final-cta" data-door-target="agents"><span data-lang-en="">Agents</span><span data-lang-th="">สำหรับเอเจนต์</span></a></li>
        <li><a href="#cap-card-human" data-door-target="humans"><span data-lang-en="">Humans</span><span data-lang-th="">สำหรับคุณ</span></a></li>
        <li><a href="/docs"><span data-lang-en="">Docs</span><span data-lang-th="">เอกสาร</span></a></li>
        <li><a href="/docs/mcp/"><span data-lang-en="">Setup</span><span data-lang-th="">วิธีติดตั้ง</span></a></li>
      </ul>
      <div class="nav-right">
        <!-- #197 R3: a language control, not a country picker. Two honest
             options, text-only labels, no flags or country names. -->
        <div class="lang-menu" id="lang-menu-wrap" role="group" aria-label="Language">
          <button type="button" class="lang-menu-btn" id="lang-menu-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Language">
            <span class="lang-menu-label" id="lang-menu-current">EN</span>
            <svg class="lang-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
          <div class="lang-menu-panel" id="lang-menu-panel" role="dialog" aria-modal="false" aria-label="Language">
            <ul class="lang-menu-list" id="lang-menu-list" role="listbox" aria-label="Language">
              <li class="lang-option" role="option" data-lang="en" aria-selected="true" aria-current="true" tabindex="0">
                <span class="lang-option-name">English</span>
                <svg class="lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
              </li>
              <li class="lang-option" role="option" data-lang="th" lang="th" aria-selected="false" aria-current="false" tabindex="0">
                <span class="lang-option-name">ไทย</span>
                <svg class="lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
              </li>
            </ul>
          </div>
        </div>
        <div class="nav-split-cta" id="nav-auth-cta">
          <!-- State: Guest / Unauthenticated (Default) -->
          <div class="nav-auth-state nav-auth-state--guest" id="nav-state-guest">
            <a href={SIGN_IN_URL} class="btn btn-primary nav-auth-btn" data-od-id="nav-btn-signin" aria-label="Sign in to Excited Live">
              <span data-lang-en="">Sign In</span>
              <span data-lang-th="">เข้าสู่ระบบ</span>
            </a>
            
          </div>
        </div>
      </div>
    </nav>
  </header>
  <main>
    <!-- Hero: Centred Editorial Column + x.ai-Style Product Capability Grid (Audience tabs section and former capability header removed) -->
    <section class="hero-doors-section" data-od-id="dir-b-hero">
      <div class="container">
        

        <div class="hero-editorial-center">
          {/* One availability claim, identical to /docs/mcp and /docs/pricing: MCP sign-in is "in final testing" (issue #104). Flip only when #31 passes end to end. */}
          <div class="eyebrow">
            <span data-lang-en="">Connect your agent over MCP · in final testing</span><span data-lang-th="">เชื่อมต่อเอเจนต์ของคุณผ่าน MCP · กำลังทดสอบขั้นสุดท้าย</span>
          </div>
          <h1>
            <span data-lang-en="">Financial planning for <span class="xai-swap-container"><span class="xai-swap-roller" aria-label="solopreneurs, first jobber, AI native"><span class="xai-swap-track"><span class="xai-swap-word">solopreneurs.</span><span class="xai-swap-word">first jobber.</span><span class="xai-swap-word">AI native.</span><span class="xai-swap-word" aria-hidden="true">solopreneurs.</span></span></span><span class="xai-swap-underline" aria-hidden="true"></span></span></span>
            <span data-lang-th="">การวางแผนการเงินสำหรับ <span class="xai-swap-container"><span class="xai-swap-roller" aria-label="โซโลพรีเนอร์, First Jobber, AI Native"><span class="xai-swap-track"><span class="xai-swap-word">โซโลพรีเนอร์</span><span class="xai-swap-word">First Jobber</span><span class="xai-swap-word">AI Native</span><span class="xai-swap-word" aria-hidden="true">โซโลพรีเนอร์</span></span></span><span class="xai-swap-underline" aria-hidden="true"></span></span></span>
          </h1>
          <p class="hero-editorial-sub"><span data-lang-en="">Connect Claude, ChatGPT, or Claude Code over MCP, then ask your agent to set up your accounts, bills, and runway. MCP sign-in is in final testing; we launch on 31 Oct 2026.</span><span data-lang-th="">เชื่อมต่อ Claude, ChatGPT หรือ Claude Code ผ่าน MCP แล้วให้เอเจนต์ช่วยตั้งค่าบัญชี บิล และรันเวย์ของคุณ การเข้าสู่ระบบ MCP กำลังทดสอบขั้นสุดท้าย เราเปิดตัว 31 ต.ค. 2026</span></p>
          <div class="hero-actions" data-od-id="hero-actions">
            <a href="/docs/mcp/" class="btn btn-primary" data-od-id="hero-btn-getting-started">
              <span data-lang-en="">Connect your agent</span>
              <span data-lang-th="">เชื่อมต่อเอเจนต์</span>
            </a>
            <a href="/docs" class="btn btn-secondary" data-od-id="hero-btn-view-docs">
              <span data-lang-en="">View Documentation</span>
              <span data-lang-th="">ดูเอกสารประกอบ</span>
            </a>
          </div>
        </div>

        <!-- Capabilities · five-move product grid (x.ai-style card anatomy, adapted to the Mastercard tokens) -->
        <div class="b-product-grid" data-od-id="dir-b-capability-grid">
          <!-- Card 1: Ask -->
          <a class="b-product-card b-product-card--2" href="#final-cta" data-door-target="agents" data-od-id="cap-card-ask" aria-labelledby="cap-card-ask-label cap-card-ask-cta">
            <div class="b-card-visual" aria-hidden="true">
              <div class="b-chat">
                <div class="b-bubble b-bubble--user"><span data-lang-en="">What’s my runway if March revenue is ฿0?</span><span data-lang-th="">ถ้ารายได้มีนาคมเป็น ฿0 รันเวย์เหลือเท่าไหร่?</span></div>
                <div class="b-bubble b-bubble--agent"><span data-lang-en="">Runway is 14 months (call: get_treasury_projection). ฿2,305,000 cash balance across Mint Living and Bean Coffee.</span><span data-lang-th="">รันเวย์ 14 เดือน (คำสั่ง get_treasury_projection) เงินสด ฿2,305,000 รวม Mint Living และ Bean Coffee</span></div>
                <div class="b-bubble b-bubble--user"><span data-lang-en="">Log ฿18,500 server cost to Mint Living.</span><span data-lang-th="">จดค่าเซิร์ฟเวอร์ ฿18,500 เข้า Mint Living</span></div>
              </div>
            </div>
            <div class="b-card-foot">
              <div><span class="b-card-label" id="cap-card-ask-label"><span data-lang-en="">Ask your agent</span><span data-lang-th="">ถามเอเจนต์ของคุณ</span></span><span class="b-card-sub"><span data-lang-en="">Ask live, runway check, log expenses</span><span data-lang-th="">ถามสด · เช็กรันเวย์ · จดรายจ่าย</span></span></div>
              <span class="b-card-cta" id="cap-card-ask-cta"><span data-lang-en="">Ask in your agent →</span><span data-lang-th="">ถามผ่านเอเจนต์ →</span></span>
            </div>
          </a>

          <!-- Card 2: What-if -->
          <a class="b-product-card b-product-card--2 b-product-card--dark" href="#final-cta" data-door-target="agents" data-od-id="cap-card-what-if" aria-labelledby="cap-card-what-if-label cap-card-what-if-cta">
            <div class="b-card-visual" aria-hidden="true">
              <div class="b-terminal">
                <div class="b-terminal-bar">
                  <span class="b-dot"></span><span class="b-dot"></span><span class="b-dot"></span>
                  <span class="b-terminal-path">{MCP_DISPLAY} · get_treasury_projection</span>
                </div>
                <div class="b-terminal-body">
                  <div class="b-term-line"><span class="b-term-prompt">&gt;</span><span>excited.get_treasury_projection --future-months 24</span></div>
                  <div class="b-term-meta">projecting 24 months · Thai tax 2026</div>
                  <div class="b-term-row"><span>Mint Living:</span><span class="b-term-value">runway 17m → 12m</span></div>
                  <div class="b-term-row"><span>Bean Coffee:</span><span class="b-term-value">runway 8m → 6m</span></div>
                  <div class="b-term-ok">✓ recommendation: defer studio expansion</div>
                </div>
              </div>
            </div>
            <div class="b-card-foot">
              <div><span class="b-card-label" id="cap-card-what-if-label"><span data-lang-en="">Planning for Future</span><span data-lang-th="">วางแผนอนาคต</span></span><span class="b-card-sub"><span data-lang-en="">What-if simulation, retirement planning</span><span data-lang-th="">จำลองสถานการณ์ · วางแผนเกษียณ</span></span></div>
              <span class="b-card-cta" id="cap-card-what-if-cta"><span data-lang-en="">Connect your agent →</span><span data-lang-th="">เชื่อมต่อเอเจนต์ →</span></span>
            </div>
          </a>

          <!-- Card 3: Log -->
          <a class="b-product-card b-product-card--2 b-product-card--warm" href="#final-cta" data-door-target="agents" data-od-id="cap-card-log" aria-labelledby="cap-card-log-label cap-card-log-cta">
            <div class="b-card-visual" aria-hidden="true">
              <div class="b-bot">
                <div class="b-bubble b-bubble--user"><span data-lang-en="">Log ฿850 for the gear repair.</span><span data-lang-th="">จด ฿850 ค่าซ่อมอุปกรณ์</span></div>
                <div class="b-bot-row">
                  <span class="b-bot-avatar">ex</span>
                  <div class="b-bubble b-bubble--agent"><span data-lang-en="">Logged to Mint Studio (call: add_expense). March burn is now ฿42,300.</span><span data-lang-th="">จดเข้า Mint Studio แล้ว (คำสั่ง add_expense) เบิร์นมีนาคมเป็น ฿42,300</span></div>
                </div>
              </div>
            </div>
            <div class="b-card-foot">
              <div><span class="b-card-label" id="cap-card-log-label"><span data-lang-en="">Manage the Current</span><span data-lang-th="">จัดการปัจจุบัน</span></span><span class="b-card-sub"><span data-lang-en="">Budgeting, asset depreciation, tax</span><span data-lang-th="">งบประมาณ · ค่าเสื่อมราคา · ภาษี</span></span></div>
              <span class="b-card-cta" id="cap-card-log-cta"><span data-lang-en="">Connect your agent →</span><span data-lang-th="">เชื่อมต่อเอเจนต์ →</span></span>
            </div>
          </a>

          <!-- Card 4: Human account -->
          <a class="b-product-card b-product-card--3 b-product-card--human" href={SIGN_UP_URL} id="cap-card-human" data-od-id="cap-card-human" aria-labelledby="cap-card-human-label cap-card-human-cta">
            <div class="b-card-visual" aria-hidden="true">
              <div class="b-human-checks">
                <div class="b-human-check"><span class="b-human-check-mark">✓</span><span><span data-lang-en="">One account for every agent</span><span data-lang-th="">บัญชีเดียวสำหรับทุกเอเจนต์</span></span></div>
                <div class="b-human-check"><span class="b-human-check-mark">✓</span><span><span data-lang-en="">Scoped keys you can revoke</span><span data-lang-th="">คีย์แบบจำกัดสิทธิ์ที่เพิกถอนได้</span></span></div>
                <div class="b-human-check"><span class="b-human-check-mark">✓</span><span><span data-lang-en="">Agent activity in plain language</span><span data-lang-th="">ดูสิ่งที่เอเจนต์ทำได้เข้าใจง่าย</span></span></div>
              </div>
            </div>
            <div class="b-card-foot">
              <div><span class="b-card-label" id="cap-card-human-label"><span data-lang-en="">Human Control</span><span data-lang-th="">คุณควบคุม</span></span><span class="b-card-sub"><span data-lang-en="">Free during launch · Android app at launch</span><span data-lang-th="">ฟรีช่วงเปิดตัว · แอป Android เปิดตัวพร้อมกัน</span></span></div>
              <span class="b-card-cta" id="cap-card-human-cta"><span data-lang-en="">Create an account →</span><span data-lang-th="">สร้างบัญชี →</span></span>
            </div>
          </a>

          <!-- Card 5: Runway -->
