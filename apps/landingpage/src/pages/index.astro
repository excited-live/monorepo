      var dropdownWrap = document.getElementById('country-dropdown-wrap');
      var dropdownBtn = document.getElementById('country-dropdown-btn');
      var searchInput = document.getElementById('country-search-input');
      var countryItems = Array.prototype.slice.call(document.querySelectorAll('.country-item'));
      var emptyState = document.getElementById('country-empty-state');
      var currentFlagUse = document.querySelector('#country-current-flag use');
      var currentLabel = document.getElementById('country-current-label');
      var langButtons = document.querySelectorAll('.lang-switch--footer [data-set-lang]');

      function setCountryAndLang(code, lang, persist) {
        var validLang = lang === 'th' ? 'th' : 'en';
        htmlEl.setAttribute('data-lang', validLang);
        htmlEl.setAttribute('lang', validLang);
        if (currentFlagUse) currentFlagUse.setAttribute('href', '#flag-' + code.toLowerCase());
        if (currentLabel) currentLabel.textContent = code;
        countryItems.forEach(function (item) {
          item.setAttribute('aria-selected', item.getAttribute('data-country-code') === code ? 'true' : 'false');
        });
        langButtons.forEach(function (btn) {
          var active = btn.getAttribute('data-set-lang') === validLang;
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          btn.classList.toggle('is-active', active);
        });
        if (persist) {
          try {
            localStorage.setItem('exl-lang', validLang);
            localStorage.setItem(STORAGE_KEY_LANG, validLang);
            localStorage.setItem(STORAGE_KEY_COUNTRY, code);
          } catch (e) {}
        }
      }

      function visibleItems() {
        return countryItems.filter(function (item) { return item.style.display !== 'none'; });
      }

      function filterCountries(query) {
        var q = (query || '').trim().toLowerCase();
        var matchCount = 0;
        countryItems.forEach(function (item) {
          var name = item.getAttribute('data-country-name') || '';
          var code = (item.getAttribute('data-country-code') || '').toLowerCase();
          var native = ((item.querySelector('.country-item-meta span') || {}).textContent || '').toLowerCase();
          var matches = !q || name.indexOf(q) !== -1 || code.indexOf(q) !== -1 || native.indexOf(q) !== -1;
          item.style.display = matches ? 'flex' : 'none';
          if (matches) matchCount++;
        });
        if (emptyState) emptyState.style.display = matchCount === 0 ? 'block' : 'none';
      }

      function toggleDropdown(open, returnFocus) {
        var willOpen = typeof open === 'boolean' ? open : !dropdownWrap.classList.contains('is-open');
        dropdownWrap.classList.toggle('is-open', willOpen);
        dropdownBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        if (willOpen) {
          searchInput.value = '';
          filterCountries('');
          setTimeout(function () { searchInput.focus(); }, 60);
        } else if (returnFocus !== false) {
          dropdownBtn.focus();
        }
      }

      if (dropdownWrap && dropdownBtn && searchInput) {
        dropdownBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          toggleDropdown();
        });
        searchInput.addEventListener('input', function () { filterCountries(searchInput.value); });
        searchInput.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            var first = visibleItems()[0];
            if (first) first.focus();
          } else if (e.key === 'Enter') {
            e.preventDefault();
            var only = visibleItems()[0];
            if (only) only.click();
          }
        });
        countryItems.forEach(function (item) {
          function pickItem() {
            setCountryAndLang(item.getAttribute('data-country-code'), item.getAttribute('data-country-lang'), true);
            toggleDropdown(false);
          }
          item.addEventListener('click', function (e) { e.stopPropagation(); pickItem(); });
          item.addEventListener('keydown', function (e) {
            var list = visibleItems();
            var idx = list.indexOf(item);
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              pickItem();
            } else if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (list[idx + 1]) list[idx + 1].focus();
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (idx > 0) list[idx - 1].focus();
              else searchInput.focus();
            }
          });
        });
        document.addEventListener('click', function (e) {
          if (!dropdownWrap.contains(e.target)) toggleDropdown(false, false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && dropdownWrap.classList.contains('is-open')) toggleDropdown(false);
        });
      }

      // Footer EN / TH pill drives the same state as the dropdown (TH -> Thailand, EN -> United States)
      langButtons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var lang = btn.getAttribute('data-set-lang');
          setCountryAndLang(lang === 'th' ? 'TH' : 'US', lang, true);
        });
      });

      // Restore saved country / language
      try {
        var savedCountry = localStorage.getItem(STORAGE_KEY_COUNTRY);
        var savedLang = localStorage.getItem(STORAGE_KEY_LANG) || localStorage.getItem('exl-lang') || htmlEl.getAttribute('data-lang') || 'en';
        var savedItem = savedCountry ? document.querySelector('.country-item[data-country-code="' + savedCountry + '"]') : null;
        if (savedItem) setCountryAndLang(savedCountry, savedItem.getAttribute('data-country-lang'), false);
        else setCountryAndLang(savedLang === 'th' ? 'TH' : 'US', savedLang, false);
      } catch (e) {
        setCountryAndLang('US', 'en', false);
      }
      /* 2. Audience Tabs + Door Card Controllers */
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
      var panels = {
        agents: document.getElementById('b-panel-agents'),
        humans: document.getElementById('b-panel-humans')
      };
      function selectTab(key, focusTab) {
        tabs.forEach(function (tab) {
          var isSelected = tab.getAttribute('data-tab-key') === key;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.setAttribute('tabindex', isSelected ? '0' : '-1');
          if (isSelected && focusTab) tab.focus();
        });
        Object.keys(panels).forEach(function (k) {
          if (panels[k]) {
            if (k === key) panels[k].removeAttribute('hidden');
            else panels[k].setAttribute('hidden', 'hidden');
          }
        });
      }
      tabs.forEach(function (tab, idx) {
        tab.addEventListener('click', function () {
          selectTab(tab.getAttribute('data-tab-key'), false);
        });
        tab.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            var nextIdx = (idx + 1) % tabs.length;
            selectTab(tabs[nextIdx].getAttribute('data-tab-key'), true);
          }
        });
      });
      document.querySelectorAll('[data-door-target]').forEach(function (el) {
        function activateDoor(e) {
          var key = el.getAttribute('data-door-target');
          var target = key === 'humans' ? document.getElementById('cap-card-plan') : document.getElementById('final-cta');
          if (target) {
            if (e && el.tagName === 'A') e.preventDefault();
            window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - 90, behavior: 'smooth' });
          }
        }
        el.addEventListener('click', activateDoor);
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateDoor(e);
          }
        });
      });
      /* 3. Copy Prompt with Fallback */
      document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var sourceEl = document.getElementById(targetId);
          var text = sourceEl ? sourceEl.textContent.trim() : '';
          var defaultLabels = btn.querySelectorAll('.copy-label-default');
          var doneLabels = btn.querySelectorAll('.copy-label-done');
          var fallbackArea = btn.parentElement.parentElement.querySelector('.copy-fallback-area');
          function showCopied() {
            defaultLabels.forEach(function (el) { el.style.display = 'none'; });
            doneLabels.forEach(function (el) { el.style.display = 'inline'; });
            setTimeout(function () {
              defaultLabels.forEach(function (el) { el.style.display = ''; });
              doneLabels.forEach(function (el) { el.style.display = 'none'; });
            }, 2200);
          }
          function fallbackCopy() {
            if (fallbackArea) {
              fallbackArea.style.display = 'block';
              fallbackArea.focus();
              fallbackArea.select();
              try {
                document.execCommand('copy');
                showCopied();
              } catch (err) {}
            }
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopied).catch(fallbackCopy);
          } else {
            fallbackCopy();
          }
        });
      });
      /* 4. Condensing / Hide-on-scroll-down Nav */
      var navShell = document.getElementById('site-nav');
      var lastY = window.scrollY || 0;
      window.addEventListener('scroll', function () {
        var y = window.scrollY || 0;
        if (y > 80) {
          navShell.classList.add('is-condensed');
          if (y > lastY + 12) navShell.classList.add('is-hidden');
          else if (y < lastY - 8) navShell.classList.remove('is-hidden');
        } else {
          navShell.classList.remove('is-condensed', 'is-hidden');
        }
        lastY = y;
      }, { passive: true });
    })();
  </script>



</Layout>

