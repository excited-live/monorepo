---
import Layout from '@/components/layout.astro';
import WaitlistForm from '@/components/WaitlistForm';
import LangSelect from '@/components/LangSelect';
import '@/styles/landing-motion.css';

const title = 'excited.live — Know your runway across every project';
const description =
	'A free Android app that shows how long your cash lasts across your day job, side projects and every business, in one place. Join the waitlist.';

const appSchema = {
	'@type': 'SoftwareApplication',
	name: 'excited.live',
	description,
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Android',
	inLanguage: ['en', 'th'],
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'THB' },
	publisher: { '@id': 'https://excited.live/#org' },
};

// Example data. Mirrors the demo fixtures behind the app screenshots
// (apps/biz-mobile/src/testing/landing-fixtures.ts), so the toggle and the
// phone never disagree.
const entities = [
	{
		name: 'Mint Living',
		tag: { en: 'Personal', th: 'ส่วนตัว' },
		runway: 17,
		fill: 71,
		cash: '฿1,025,600',
		burn: '฿60,440',
		bx: '12%',
		by: '34%',
		br: '-5deg',
	},
	{
		name: 'Bean Coffee',
		tag: { en: 'Business', th: 'ธุรกิจ' },
		runway: 16,
		fill: 67,
		cash: '฿760,100',
		burn: '฿47,500',
		bx: '-4%',
		by: '-24%',
		br: '4deg',
	},
	{
		name: 'Mint Studio',
		tag: { en: 'Business', th: 'ธุรกิจ' },
		runway: 20,
		fill: 83,
		cash: '฿519,700',
		burn: '฿26,000',
		bx: '-22%',
		by: '16%',
		br: '-3deg',
	},
];

const noise = [
	{ icon: '📊', en: 'money_final_v7.xlsx', th: 'money_final_v7.xlsx', nx: '4%', ny: '7%', nr: '-4deg' },
	{ icon: '🏦', en: '3 bank apps', th: 'แอปธนาคาร 3 แอป', nx: '63%', ny: '5%', nr: '3deg' },
	{ icon: '💬', en: 'LINE: slips', th: 'LINE: สลิป', nx: '5%', ny: '80%', nr: '4deg', extra: true },
	{ icon: '🧾', en: 'POS export.csv', th: 'POS export.csv', nx: '68%', ny: '82%', nr: '-3deg', extra: true },
];

const asks = [
	{
		en: 'How much can I spend on the café?',
		th: 'ใช้เงินกับร้านกาแฟได้เท่าไหร่?',
		nx: '33%',
		ny: '13%',
		nr: '-2deg',
	},
	{
		en: 'How long is the studio’s runway?',
		th: 'สตูดิโอไปต่อได้อีกกี่เดือน?',
		nx: '56%',
		ny: '50%',
		nr: '2deg',
	},
	{
		en: '…and what about my own life?',
		th: 'แล้วชีวิตส่วนตัวล่ะ?',
		nx: '6%',
		ny: '57%',
		nr: '-3deg',
	},
];

const media = [
	{
		img: '/app/mobile/runway.webp',
		shift: '0%',
		h: { en: 'Runway, not just a balance', th: 'รันเวย์ ไม่ใช่แค่ยอดเงิน' },
		p: {
			en: 'See months of cash left, your monthly net burn, and whether you are default alive.',
			th: 'เห็นว่าเงินพออีกกี่เดือน เผาเงินสุทธิเท่าไหร่ และรอดไหม',
		},
	},
	{
		img: '/app/mobile/expenses.webp',
		shift: '-54%',
		h: { en: 'Every bill, smoothed', th: 'ทุกบิล เฉลี่ยเป็นรายเดือน' },
		p: {
			en: 'Yearly and quarterly charges become one monthly number, with renewal alerts a week ahead.',
			th: 'ค่าใช้จ่ายรายปีและรายไตรมาสถูกแปลงเป็นตัวเลขรายเดือน พร้อมเตือนล่วงหน้า 7 วัน',
		},
	},
	{
		img: '/app/mobile/gear.webp',
		shift: '-52%',
		h: { en: 'Gear that depreciates honestly', th: 'อุปกรณ์ที่ค่าเสื่อมถูกต้อง' },
		p: {
			en: 'Your laptop becomes a monthly cost, not a lump-sum surprise.',
			th: 'โน้ตบุ๊กกลายเป็นต้นทุนรายเดือน ไม่ใช่ก้อนใหญ่ที่โผล่มาให้ตกใจ',
		},
	},
];

const minis = [
	{
		icon: '💼',
		h: { en: 'Payday countdown', th: 'นับถอยหลังวันเงินเดือน' },
		p: {
			en: 'Your day job gets an UNTIL card: days to payday and months to your freedom buffer.',
			th: 'งานประจำมีการ์ด UNTIL บอกวันถึงเงินเดือน และอีกกี่เดือนถึงเงินสำรองอิสรภาพ',
		},
	},
	{
		icon: '🏪',
		h: { en: 'Many businesses, one app', th: 'หลายธุรกิจ แอปเดียว' },
		p: {
			en: 'Each venture gets its own cash, bills and runway. Switch in one tap.',
			th: 'แต่ละธุรกิจมีเงินสด บิล และรันเวย์ของตัวเอง สลับได้ในแตะเดียว',
		},
	},
	{
		icon: '🔁',
		h: { en: 'Move money, keep the math', th: 'โอนเงินเข้าธุรกิจ ตัวเลขยังเป๊ะ' },
		p: {
			en: 'Inject capital from personal into a business and both runways update instantly.',
			th: 'ใส่ทุนจากส่วนตัวเข้าธุรกิจ แล้วรันเวย์ทั้งสองฝั่งอัปเดตทันที',
		},
	},
];
---

<Layout title={title} description={description} schema={appSchema}>
	<!-- Motion arms before the hero paints: no-JS and reduced-motion visitors get
	     the static page, everyone else gets the choreography. See landing-motion.css. -->
	<script is:inline data-astro-rerun>
		(function () {
			try {
				if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					document.documentElement.classList.add('motion');
				}
			} catch (e) {
				/* matchMedia unavailable — leave the static page */
			}
		})();
	</script>

	<!-- ============ NAV ============ -->
	<div class="nav-wrap">
		<nav class="nav-pill" aria-label="Main">
			<a class="nav-brand" href="/" aria-label="excited.live">
				<img src="/logo-mark.png" alt="" width="28" height="28" />
				<span>excited<span class="brand-dot">.live</span></span>
			</a>
			<div class="nav-links">
				<a href="#features">
					<span data-lang-en>Features</span>
					<span data-lang-th>ฟีเจอร์</span>
				</a>
				<a href="#next">
					<span data-lang-en>Coming next</span>
					<span data-lang-th>เร็ว ๆ นี้</span>
				</a>
				<a href="/blog">
					<span data-lang-en>Blog</span>
					<span data-lang-th>บล็อก</span>
				</a>
				<a href="/docs">
					<span data-lang-en>Docs</span>
					<span data-lang-th>เอกสาร</span>
				</a>
			</div>
			<div class="nav-actions">
				<LangSelect client:load />
				<a class="btn-ink" href="#waitlist">
					<span data-lang-en>Join waitlist</span>
					<span data-lang-th>ลงทะเบียน</span>
				</a>
			</div>
		</nav>
	</div>

	<!-- ============ HERO ============ -->
	<header class="hero" id="waitlist">
		<div class="hero-inner">
			<p class="eyebrow" data-load style="--ld: 0">
				<span data-lang-en>Free Android app</span>
				<span data-lang-th>แอป Android ฟรี</span>
			</p>
			<h1>
				<span data-lang-en>
					<span class="line" style="--ld: 80"><span>Every project.</span></span>
					<span class="line" style="--ld: 170"><span>Every baht.</span></span>
					<span class="line" style="--ld: 260"><span>One <span class="accent">runway</span>.</span></span>
				</span>
				<span data-lang-th>
					<span class="line" style="--ld: 80"><span>ทุกโปรเจกต์ ทุกบาท</span></span>
					<span class="line" style="--ld: 170"><span>ใน<span class="accent">รันเวย์เดียว</span></span></span>
				</span>
			</h1>
			<p class="hero-sub" data-load style="--ld: 380">
				<span data-lang-en>
					See how long your cash lasts across your day job, your side projects and your
					businesses. One free app, one honest number.
				</span>
				<span data-lang-th>
					ดูว่าเงินพออีกกี่เดือน ทั้งเงินเดือน ไซด์โปรเจกต์ และธุรกิจ
					ในแอปฟรีแอปเดียว ตัวเลขเดียวที่ไม่หลอกตัวเอง
				</span>
			</p>
			<div class="hero-perks" data-load style="--ld: 470">
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Free</span>
					<span data-lang-th>ฟรี</span>
				</span>
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Works offline</span>
					<span data-lang-th>ใช้ได้แบบออฟไลน์</span>
				</span>
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Made for Thai life</span>
					<span data-lang-th>ออกแบบมาเพื่อคนไทย</span>
				</span>
			</div>
			<div data-load style="--ld: 560"><WaitlistForm client:visible /></div>
		</div>

		<div class="hero-visual">
			<svg class="hero-orbit" viewBox="0 0 520 640" preserveAspectRatio="none" aria-hidden="true">
				<path d="M 30 600 C 40 380, 120 160, 470 40" />
				<circle class="beacon" r="3.5" cx="0" cy="0">
					<animateMotion dur="16s" repeatCount="indefinite" path="M 30 600 C 40 380, 120 160, 470 40" />
				</circle>
			</svg>
			<div class="phone" data-load style="--ld: 220">
				<div class="phone-screen">
					<img
						src="/app/mobile/home.webp"
						width="780"
						height="1568"
						alt="The excited.live app showing consolidated wealth and three accounts: a personal account with a payday countdown and two businesses"
						fetchpriority="high"
					/>
				</div>
			</div>
			<span class="float-chip chip-a" data-load style="--ld: 620">
				<span class="dot"></span>
				<span data-lang-en>Runway <span data-count="17">17</span> mo</span>
				<span data-lang-th>รันเวย์ <span data-count="17">17</span> เดือน</span>
			</span>
			<span class="float-chip chip-b" data-load style="--ld: 700">
				<span data-lang-en>Payday in 10 days</span>
				<span data-lang-th>อีก 10 วันเงินเดือนออก</span>
			</span>
			<span class="float-chip chip-c" data-load style="--ld: 780">
				<span data-lang-en>3 businesses, 1 view</span>
				<span data-lang-th>3 ธุรกิจ ดูที่เดียว</span>
			</span>
		</div>
	</header>

	<!-- ============ BEFORE / AFTER ============ -->
	<section class="section" id="problem">
		<div class="section-head">
			<p class="eyebrow">
				<span data-lang-en>Before and after</span>
				<span data-lang-th>ก่อน และ หลัง</span>
			</p>
			<h2>
				<span data-lang-en>Too many projects. No single answer.</span>
				<span data-lang-th>หลายโปรเจกต์ แต่ไม่มีคำตอบเดียว</span>
			</h2>
			<p>
				<span data-lang-en>
					Flip the switch and see what changes when every project, business and your own
					life share one runway.
				</span>
				<span data-lang-th>
					กดสวิตช์ดูว่าจะเปลี่ยนไปแค่ไหน เมื่อทุกโปรเจกต์ ทุกธุรกิจ
					และชีวิตส่วนตัวอยู่ในรันเวย์เดียว
				</span>
			</p>
		</div>

		<div class="chaos" data-state="after">
			<div class="switch" role="group" aria-label="Before and after">
				<button type="button" class="switch-btn" data-view="before" aria-pressed="false">
					<span data-lang-en>Before</span>
					<span data-lang-th>ก่อน</span>
				</button>
				<button type="button" class="switch-btn" data-view="after" aria-pressed="true">
					<span data-lang-en>With excited.live</span>
					<span data-lang-th>มี excited.live</span>
				</button>
			</div>

			<div class="chaos-stage">
				<div class="chaos-total">
					<p class="eyebrow">
						<span data-lang-en>Consolidated wealth</span>
						<span data-lang-th>ความมั่งคั่งรวม</span>
					</p>
					<span class="total-num swap">
						<span class="is-before">฿ ???</span>
						<span class="is-after" data-odometer="2305400">฿2,305,400</span>
					</span>
					<span class="total-hint swap">
						<span class="is-before">
							<span data-lang-en>nobody knows</span>
							<span data-lang-th>ไม่มีใครรู้</span>
						</span>
						<span class="is-after">
							<span data-lang-en>across 3 accounts</span>
							<span data-lang-th>รวม 3 บัญชี</span>
						</span>
					</span>
				</div>

				<div class="ent-grid">
					{
						entities.map((e) => (
							<article class="ent" style={`--bx:${e.bx};--by:${e.by};--br:${e.br};--fill:${e.fill}%`}>
								<div class="ent-top">
									<span class="ent-name">{e.name}</span>
									<span class="ent-tag">
										<span data-lang-en>{e.tag.en}</span>
										<span data-lang-th>{e.tag.th}</span>
									</span>
								</div>
								<div class="ent-runway swap">
									<span class="is-before">
										??<small>
											<span data-lang-en>mo</span>
											<span data-lang-th>เดือน</span>
										</small>
									</span>
									<span class="is-after">
										{e.runway}<small>
											<span data-lang-en>mo runway</span>
											<span data-lang-th>เดือน รันเวย์</span>
										</small>
									</span>
								</div>
								<div class="ent-bar" aria-hidden="true">
									<span />
								</div>
								<div class="ent-rows">
									<div>
										<span>
											<span data-lang-en>Cash</span>
											<span data-lang-th>เงินสด</span>
										</span>
										<b class="swap">
											<span class="is-before">฿ ???</span>
											<span class="is-after">{e.cash}</span>
										</b>
									</div>
									<div>
										<span>
											<span data-lang-en>Burn / mo</span>
											<span data-lang-th>ค่าใช้จ่าย/เดือน</span>
										</span>
										<b class="swap">
											<span class="is-before">฿ ???</span>
											<span class="is-after">{e.burn}</span>
										</b>
									</div>
								</div>
							</article>
						))
					}
				</div>

				{
					noise.map((n) => (
						<span
							class={`noise${n.extra ? ' noise--extra' : ''}`}
							style={`--nx:${n.nx};--ny:${n.ny};--nr:${n.nr}`}
							aria-hidden="true"
						>
							<span>{n.icon}</span>
							<span data-lang-en>{n.en}</span>
							<span data-lang-th>{n.th}</span>
						</span>
					))
				}
				{
					asks.map((a) => (
						<span class="ask" style={`--nx:${a.nx};--ny:${a.ny};--nr:${a.nr}`} aria-hidden="true">
							<span data-lang-en>{a.en}</span>
							<span data-lang-th>{a.th}</span>
						</span>
					))
				}
			</div>

			<div class="chaos-caption" aria-live="polite">
				<p class="is-before">
					<span data-lang-en>Five tools, three projects, and still no answer.</span>
					<span data-lang-th>5 เครื่องมือ 3 โปรเจกต์ แต่ยังตอบไม่ได้</span>
				</p>
				<p class="is-after">
					<span data-lang-en>One view. Every runway. Updated as you log.</span>
					<span data-lang-th>มุมมองเดียว เห็นทุกรันเวย์ อัปเดตทุกครั้งที่จด</span>
				</p>
			</div>
			<p class="chaos-example">
				<span data-lang-en>Example data from the app.</span>
				<span data-lang-th>ข้อมูลตัวอย่างจากในแอป</span>
			</p>
		</div>
	</section>

	<!-- ============ FEATURES ============ -->
	<section class="section" id="features">
		<div class="section-head">
			<p class="eyebrow">
				<span data-lang-en>What is inside</span>
				<span data-lang-th>มีอะไรในแอป</span>
			</p>
			<h2>
				<span data-lang-en>Built for people who run more than one thing.</span>
				<span data-lang-th>สร้างมาเพื่อคนที่ทำมากกว่าหนึ่งอย่าง</span>
			</h2>
			<p>
				<span data-lang-en>
					Cash, bills and gear for you and every venture, with honest math underneath.
				</span>
				<span data-lang-th>
					เงินสด บิล และอุปกรณ์ ของคุณและทุกธุรกิจ ด้วยการคำนวณที่ตรงไปตรงมา
				</span>
			</p>
		</div>

		<div class="bento">
			{
				media.map((m) => (
					<article class="bento-card">
						<div class="bento-copy">
							<h3>
								<span data-lang-en>{m.h.en}</span>
								<span data-lang-th>{m.h.th}</span>
							</h3>
							<p>
								<span data-lang-en>{m.p.en}</span>
								<span data-lang-th>{m.p.th}</span>
							</p>
						</div>
						<div class="bento-shot">
							<img src={m.img} alt="" loading="lazy" width="780" height="1500" style={`transform:translateY(${m.shift})`} />
						</div>
					</article>
				))
			}
		</div>

		<div class="perk-cards is-tight">
			{
				minis.map((m) => (
					<article class="perk-card">
						<span class="perk-icon" aria-hidden="true">
							{m.icon}
						</span>
						<h3>
							<span data-lang-en>{m.h.en}</span>
							<span data-lang-th>{m.h.th}</span>
						</h3>
						<p>
							<span data-lang-en>{m.p.en}</span>
							<span data-lang-th>{m.p.th}</span>
						</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- ============ HOW IT WORKS ============ -->
	<section class="section" id="how">
		<div class="section-head">
			<p class="eyebrow">
				<span data-lang-en>How it works</span>
				<span data-lang-th>ใช้งานอย่างไร</span>
			</p>
			<h2>
				<span data-lang-en>Three steps to an honest number.</span>
				<span data-lang-th>สามขั้นตอนสู่ตัวเลขที่จริงใจ</span>
			</h2>
		</div>

		<div class="orbit-stage">
			<svg class="orbit-svg" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
				<path d="M 200 170 C 420 30, 780 30, 1000 170" />
				<circle class="beacon" r="3.5" cx="0" cy="0">
					<animateMotion dur="18s" repeatCount="indefinite" path="M 200 170 C 420 30, 780 30, 1000 170" />
				</circle>
			</svg>
			<div class="orbit-item">
				<div class="orbit-circle">
					<span class="step-num">01</span>
					<span class="step-title">
						<span data-lang-en>Add your accounts</span>
						<span data-lang-th>เพิ่มบัญชีของคุณ</span>
					</span>
					<span class="satellite" aria-hidden="true">🏦</span>
				</div>
				<p class="orbit-caption">
					<span data-lang-en>Personal, your job, every business.</span>
					<span data-lang-th>ส่วนตัว งานประจำ และทุกธุรกิจ</span>
				</p>
			</div>
			<div class="orbit-item">
				<div class="orbit-circle">
					<span class="step-num">02</span>
					<span class="step-title">
						<span data-lang-en>Log bills and gear</span>
