/* How It Works: Three-Step Orbit with Drawn Arc & Circular Stations */
.orbit-how-section { position: relative; }
.orbit-constellation { position: relative; margin-top: 48px; padding: 24px 0; }
.orbit-bg-svg { position: absolute; top: 72px; left: 0; width: 100%; height: 140px; pointer-events: none; z-index: 0; overflow: visible; }
.orbit-drawn-line { fill: none; stroke: var(--orange-light); stroke-width: 1.5; stroke-linecap: round; stroke-dasharray: 1400; stroke-dashoffset: 0; animation: drawLine 700ms var(--ease-arrive) forwards; }
@keyframes drawLine {
from { stroke-dashoffset: 1400; }
to { stroke-dashoffset: 0; }
}
.orbit-stations-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
