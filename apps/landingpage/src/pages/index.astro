---
import Layout from '@/components/layout.astro';
import WaitlistForm from '@/components/WaitlistForm';
import LangSelect from '@/components/LangSelect';

const title = 'excited.live — Ask your money';
const description =
	'Connect your agent to your books over MCP. Ask about cash, bills and runway in Claude.ai, ChatGPT or Claude Code.';

// Every link into the product carries the path only; the inline script at the
// end of the page rewrites it to the prelive webapp on prelive/preview hosts so
// a preview can never create a production account.
const appSchema = {
	'@type': 'SoftwareApplication',
	name: 'excited.live',
	description,
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Web, Android',
	inLanguage: ['en', 'th'],
	publisher: { '@id': 'https://excited.live/#org' },
};
---

<Layout title={title} description={description} schema={appSchema}>
	<div class="ask-page" id="top">
		<div class="wrap">
			<nav class="nav" aria-label="Main">
				<a class="brand" href="/" aria-label="excited.live home">
					<img src="/logo-mark.png" alt="" width="26" height="26" />
					<b>excited<span>.live</span></b>
				</a>
				<div class="links">
					<a href="#how">
						<span data-lang-en>How it works</span>
						<span data-lang-th>วิธีใช้งาน</span>
					</a>
					<a href="#humans">
						<span data-lang-en>For humans</span>
						<span data-lang-th>สำหรับมนุษย์</span>
					</a>
					<a href="#faq">
						<span data-lang-en>FAQ</span>
						<span data-lang-th>คำถามที่พบบ่อย</span>
					</a>
				</div>
				<div class="navact">
					<a class="signin" href="https://app.excited.live/sign-in" data-app-link="/sign-in">
						<span data-lang-en>Sign in</span>
						<span data-lang-th>เข้าสู่ระบบ</span>
					</a>
					<a
						class="btn sm"
						href="https://app.excited.live/sign-in?mode=signup&returnPathname=%2Fdevice"
						data-app-link="/sign-in?mode=signup&returnPathname=%2Fdevice"
						data-connect
					>
						<span data-lang-en>Connect your agent</span>
						<span data-lang-th>เชื่อมต่อเอเจนต์</span>
					</a>
				</div>
			</nav>

			<div class="tabs">
				<div class="pill">
					<a class="on" href="#top">
						<span data-lang-en>For your agent</span>
						<span data-lang-th>สำหรับเอเจนต์</span>
					</a>
					<a href="#humans">
						<span data-lang-en>For humans</span>
						<span data-lang-th>สำหรับมนุษย์</span>
					</a>
				</div>
				<div class="tabs-end">
					<span class="tabnote">
						<span data-lang-en>No install</span>
						<span data-lang-th>ไม่ต้องติดตั้ง</span>
					</span>
					<LangSelect client:idle />
				</div>
			</div>
		</div>

		<main>
			<section class="hero">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							<i aria-hidden="true"></i>
							<span data-lang-en>For Claude, ChatGPT &amp; Claude Code</span>
							<span data-lang-th>ใช้ได้กับ Claude, ChatGPT และ Claude Code</span>
						</p>
						<h1>
							<span data-lang-en>
								<span class="h1line">How long can</span>
								<span class="h1line"><em>the café</em> last?</span>
							</span>
							<span data-lang-th>
								<span class="h1line">ร้านเรา</span>
								<span class="h1line"><em>ไปต่อได้อีกกี่เดือน?</em></span>
							</span>
						</h1>
						<p class="sub">
							<span data-lang-en>
								Your agent already knows your cash, bills and runway. Ask it a question like
								this one — in the chat you already use.
							</span>
							<span data-lang-th>
								เอเจนต์ของคุณรู้เงินสด บิล และรันเวย์อยู่แล้ว ถามคำถามแบบนี้ได้เลยในแชทที่คุณใช้อยู่
							</span>
						</p>
						<div class="ctarow">
							<a
								class="btn lg"
								href="https://app.excited.live/sign-in?mode=signup&returnPathname=%2Fdevice"
								data-app-link="/sign-in?mode=signup&returnPathname=%2Fdevice"
								data-connect
							>
								<span data-lang-en>Connect your agent</span>
								<span data-lang-th>เชื่อมต่อเอเจนต์</span>
								<span class="ar" aria-hidden="true">→</span>
							</a>
							<a class="textlink" href="#proof">
								<span data-lang-en>See it answer something else</span>
								<span data-lang-th>ดูมันตอบคำถามอื่น</span>
							</a>
						</div>
						<p class="fine">
							<span data-lang-en>About 30 seconds · Google sign-in · no install</span>
							<span data-lang-th>ราว 30 วินาที · เข้าสู่ระบบด้วย Google · ไม่ต้องติดตั้ง</span>
						</p>
					</div>

					<div
						class="card"
						id="proof"
						role="img"
						aria-label="Claude answers: 16 months at the current burn, with cash 768,000 baht and burn 47,500 baht per month, read from your books over MCP."
					>
						<div class="chead">
							<span class="av" aria-hidden="true">C</span>
							<div>
								<b>Claude</b>
								<small>
									<span data-lang-en>connected to your books</span>
									<span data-lang-th>เชื่อมกับบัญชีคุณแล้ว</span>
								</small>
							</div>
							<span class="live"><i aria-hidden="true"></i>answered · 2s</span>
						</div>
						<div class="thread">
							<p class="q">
								<span data-lang-en>How long can the café last?</span>
								<span data-lang-th>ร้านเราไปต่อได้อีกกี่เดือน?</span>
							</p>
							<div class="a">
								<span class="tag">via excited.live MCP</span>
								<p class="say">
									<span data-lang-en>At the current burn,</span>
									<span data-lang-th>ที่อัตราใช้จ่ายตอนนี้</span>
								</p>
								<p class="big">
									<span data-lang-en>16<small>months</small></span>
									<span data-lang-th>16<small>เดือน</small></span>
								</p>
								<p class="say note">
									<span data-lang-en>and that already includes the new lease.</span>
									<span data-lang-th>และรวมค่าเช่าสัญญาใหม่ไว้แล้ว</span>
								</p>
							</div>
							<div class="receipt">
								<div>
									<span data-lang-en>Cash</span>
									<span data-lang-th>เงินสด</span>
									<b>฿768,000</b>
								</div>
								<div>
									<span data-lang-en>Burn</span>
									<span data-lang-th>ใช้จ่าย</span>
									<b>฿47,500/mo</b>
								</div>
								<div>
									<span data-lang-en>Updated</span>
									<span data-lang-th>อัปเดต</span>
									<b>
										<span data-lang-en>2 min ago</span>
										<span data-lang-th>2 นาทีที่แล้ว</span>
									</b>
								</div>
							</div>
						</div>
						<div class="cfoot">
							<span data-lang-en>Read, not typed — from your books</span>
							<span data-lang-th>อ่านจากบัญชีคุณ ไม่ได้พิมพ์เอง</span>
							<a class="more" href="#how">
								<span data-lang-en>Ask another →</span>
								<span data-lang-th>ถามอีกคำถาม →</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<div class="strip">
				<div class="wrap strip-inner">
					<span class="lbl">
						<span data-lang-en>Works with the agent you already use</span>
						<span data-lang-th>ใช้กับเอเจนต์ที่คุณใช้อยู่</span>
					</span>
					<span class="who">Claude.ai · ChatGPT · Claude Code</span>
					<span class="who soft">
						<span data-lang-en>One connection · no install</span>
						<span data-lang-th>หนึ่งการเชื่อมต่อ · ไม่ต้องติดตั้ง</span>
					</span>
				</div>
			</div>

			<section class="features">
				<div class="wrap">
					<div class="grid3">
						<div class="blk">
							<span class="n">01</span>
							<h3>
								<span data-lang-en>It already has the numbers.</span>
								<span data-lang-th>ตัวเลขอยู่กับมันแล้ว</span>
							</h3>
							<p>
								<span data-lang-en>
									Your agent reads cash, bills and income through MCP. No CSV, no spreadsheet,
									no re-typing last month.
								</span>
								<span data-lang-th>
									เอเจนต์อ่านเงินสด บิล และรายได้ผ่าน MCP ไม่ต้องส่งออก CSV ไม่ต้องกรอกสเปรดชีตใหม่
								</span>
							</p>
						</div>
						<div class="blk">
							<span class="n">02</span>
							<h3>
								<span data-lang-en>It answers where you already are.</span>
								<span data-lang-th>ตอบในแชทที่คุณใช้อยู่</span>
							</h3>
							<p>
								<span data-lang-en>
									Claude, ChatGPT or Claude Code. The answer arrives in the same chat — not
									another dashboard you forget to open.
								</span>
								<span data-lang-th>
									Claude, ChatGPT หรือ Claude Code คำตอบมาในแชทเดิม ไม่ต้องเปิดแดชบอร์ดอีกอัน
								</span>
							</p>
						</div>
						<div class="blk">
							<span class="n">03</span>
							<h3>
								<span data-lang-en>Nothing is written without you.</span>
								<span data-lang-th>ไม่มีอะไรถูกบันทึกโดยไม่บอกคุณ</span>
							</h3>
							<p>
								<span data-lang-en>
									Every entry comes back as a receipt you can read. Approve it, correct it, or
									undo it with one sentence.
								</span>
								<span data-lang-th>
									ทุกรายการกลับมาเป็นใบเสร็จที่อ่านได้ จะอนุมัติ แก้ หรือย้อนกลับก็สั่งประโยคเดียว
								</span>
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="how" id="how">
				<div class="wrap">
					<div class="shead">
						<h2>
							<span data-lang-en>Three minutes of setup. Then it is just a conversation.</span>
							<span data-lang-th>ตั้งค่าสามนาที จากนั้นมันคือบทสนทนา</span>
						</h2>
						<p>
							<span data-lang-en>
								The account comes first, because the books need an owner before an agent can
								write to them.
							</span>
							<span data-lang-th>
								บัญชีมาก่อน เพราะสมุดบัญชีต้องมีเจ้าของก่อนเอเจนต์จะเขียนได้
							</span>
						</p>
					</div>
					<div class="steps">
						<div class="step">
							<span class="n">01</span>
							<h3>
								<span data-lang-en>Create your account</span>
								<span data-lang-th>สร้างบัญชี</span>
							</h3>
							<p>
								<span data-lang-en>
									One tap with Google. This is the account your agent will read and write.
								</span>
								<span data-lang-th>
									แตะเดียวด้วย Google นี่คือบัญชีที่เอเจนต์จะอ่านและเขียน
								</span>
							</p>
						</div>
						<div class="step">
							<span class="n">02</span>
							<h3>
								<span data-lang-en>Hand it one sentence</span>
								<span data-lang-th>ส่งประโยคเดียวให้มัน</span>
							</h3>
							<p>
								<span data-lang-en>
									Paste it into Claude or ChatGPT. A single-use code connects the account and
									opens the approval page.
								</span>
								<span data-lang-th>
									วางใน Claude หรือ ChatGPT รหัสใช้ครั้งเดียวจะเชื่อมบัญชีและเปิดหน้าอนุมัติ
								</span>
							</p>
						</div>
						<div class="step">
							<span class="n">03</span>
							<h3>
								<span data-lang-en>Ask</span>
								<span data-lang-th>ถาม</span>
							</h3>
							<p>
								<span data-lang-en>
									Start with “how long can we last?”. Your agent answers from the books and
									tells you what changed.
								</span>
								<span data-lang-th>
									เริ่มด้วย “เราอยู่ได้อีกนานแค่ไหน?” เอเจนต์ตอบจากบัญชีและบอกว่าอะไรเปลี่ยน
								</span>
							</p>
						</div>
						<div class="snip">
							<span class="k">
								<span data-lang-en>Single-use code</span>
								<span data-lang-th>รหัสใช้ครั้งเดียว</span>
							</span>
							<span class="snip-body">
								<span data-lang-en>Connect excited.live, then run onboard_me.</span>
								<span data-lang-th>เชื่อมต่อ excited.live แล้วรัน onboard_me</span>
							</span>
						</div>
					</div>
				</div>
			</section>

			<section class="faq" id="faq">
				<div class="wrap faq-grid">
					<div>
						<h2>
							<span data-lang-en>Questions people ask before they connect.</span>
							<span data-lang-th>คำถามที่คนถามก่อนเชื่อมต่อ</span>
						</h2>
						<p class="note">
							<span data-lang-en>If yours is not here, the docs answer the technical ones in full.</span>
							<span data-lang-th>ถ้าไม่เจอคำถามของคุณ เอกสารตอบเรื่องเทคนิคไว้ครบ</span>
						</p>
					</div>
					<div>
						<details open>
							<summary>
								<span data-lang-en>Do I need to install anything?</span>
								<span data-lang-th>ต้องติดตั้งอะไรไหม?</span>
							</summary>
							<p>
								<span data-lang-en>
									No. Your agent connects over MCP and you keep talking to it in the app you
									already use. There is no extension, no plugin store, no new app to learn.
								</span>
								<span data-lang-th>
									ไม่ต้อง เอเจนต์เชื่อมผ่าน MCP แล้วคุณคุยกับมันในแอปเดิมได้เลย ไม่มีส่วนขยาย
									ไม่มีสโตร์ปลั๊กอิน ไม่มีแอปใหม่ให้เรียนรู้
								</span>
							</p>
						</details>
						<details>
							<summary>
								<span data-lang-en>Which agents work at launch?</span>
								<span data-lang-th>ตอนเปิดตัวใช้กับเอเจนต์ตัวไหนได้บ้าง?</span>
							</summary>
							<p>
								<span data-lang-en>
									Claude.ai, ChatGPT and Claude Code. Other MCP clients can connect, but we only
									support those three on the page at launch.
								</span>
								<span data-lang-th>
									Claude.ai, ChatGPT และ Claude Code ไคลเอนต์ MCP อื่นเชื่อมได้
									แต่ตอนเปิดตัวเราดูแลแค่สามตัวนี้บนหน้าเว็บ
								</span>
							</p>
						</details>
						<details>
							<summary>
								<span data-lang-en>What can the agent actually change?</span>
								<span data-lang-th>เอเจนต์แก้อะไรได้จริง ๆ?</span>
							</summary>
							<p>
								<span data-lang-en>
									It can read your books and add or edit the entries it records for you. It
									cannot move money, and it never sees your password. Every write comes back as a
									receipt, and you can revoke access at any time.
								</span>
								<span data-lang-th>
									มันอ่านบัญชีได้ และเพิ่มหรือแก้รายการที่มันบันทึกให้คุณ โอนเงินไม่ได้
									และไม่เคยเห็นรหัสผ่าน ทุกครั้งที่เขียนจะมีใบเสร็จให้ตรวจ
									และยกเลิกสิทธิ์ได้ทุกเมื่อ
								</span>
							</p>
						</details>
						<details>
							<summary>
								<span data-lang-en>What if I don't use an agent?</span>
								<span data-lang-th>ถ้าไม่ใช้เอเจนต์ล่ะ?</span>
							</summary>
							<p>
								<span data-lang-en>
									Then the Android app is for you — same books, same numbers, no setup. It lives
									in the “For humans” tab, along with the waitlist.
								</span>
								<span data-lang-th>
									งั้นแอป Android เหมาะกับคุณ — บัญชีเดียวกัน ตัวเลขเดียวกัน ไม่ต้องตั้งค่า
									อยู่ในแท็บ “สำหรับมนุษย์” พร้อมรายชื่อรอรับสิทธิ์
								</span>
							</p>
						</details>
					</div>
				</div>
			</section>

			<section class="humans" id="humans">
				<div class="wrap humans-grid">
					<div>
						<p class="eyebrow">
							<i aria-hidden="true"></i>
							<span data-lang-en>For humans · Android</span>
							<span data-lang-th>สำหรับมนุษย์ · Android</span>
						</p>
						<h2>
							<span data-lang-en>The same books, in your pocket.</span>
							<span data-lang-th>บัญชีเดียวกัน ในกระเป๋าคุณ</span>
						</h2>
						<p>
							<span data-lang-en>
								Your agent keeps the numbers. The app is where you glance at them: runway,
								payday, every business in one place. Same books — no second setup.
							</span>
							<span data-lang-th>
								เอเจนต์ดูแลตัวเลขให้ ส่วนแอปคือที่ที่คุณเปิดดูเร็ว ๆ รันเวย์ วันเงินเดือน
								และทุกธุรกิจในที่เดียว บัญชีเดียวกัน ไม่ต้องตั้งค่าใหม่
							</span>
						</p>
					</div>
					<div id="waitlist" class="humans-form">
						<a class="btn" href="#waitlist">
							<span data-lang-en>Get the Android app</span>
							<span data-lang-th>รับแอป Android</span>
						</a>
						<WaitlistForm
							client:visible
							copy={{
								en: { button: 'Join the waitlist' },
								th: { button: 'ลงทะเบียนรอรับสิทธิ์' },
							}}
						/>
						<p class="fine">
							<span data-lang-en>
								One email at launch · no spam · the agent connection needs no waitlist
							</span>
							<span data-lang-th>
								อีเมลเดียวตอนเปิดตัว · ไม่มีสแปม · การเชื่อมต่อเอเจนต์ไม่ต้องรอ
							</span>
						</p>
					</div>
				</div>
			</section>

			<section class="final" id="connect">
				<div class="wrap final-grid">
					<div>
						<h2>
							<span data-lang-en>Ask your own agent.</span>
							<span data-lang-th>ถามเอเจนต์ของคุณเอง</span>
						</h2>
						<p>
							<span data-lang-en>
								Open your books once. After that, every money question is one message away.
							</span>
							<span data-lang-th>
								เปิดบัญชีให้มันครั้งเดียว จากนั้นทุกคำถามเรื่องเงินอยู่ห่างแค่ข้อความเดียว
							</span>
						</p>
						<p class="free">
							<span data-lang-en>Free during early access.</span>
							<span data-lang-th>ช่วง Early Access ใช้ฟรี</span>
						</p>
					</div>
