---
import Layout from '@/components/layout.astro';

const title = 'excited.live — Financial planning for solopreneurs, first jobber, AI native';
const description =
	'Tax, retirement, asset depreciation, investment tracking, and budgeting — built for your agent and for you.';

const appSchema = {
	'@type': 'SoftwareApplication',
	name: 'excited.live',
	description,
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Web, Android',
	inLanguage: ['en', 'th'],
	publisher: { '@id': 'https://excited.live/#org' },
};
---

