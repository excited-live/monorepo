.entity-card { background-color: var(--white); border: 1px solid var(--border); border-radius: 32px; padding: 26px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.entity-circle { width: 72px; height: 72px; border-radius: 50%; background-color: var(--canvas); border: 1.5px solid var(--orange-light); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
/* Capabilities + Trust + Pricing */
