              },
              cursor: {
                prompt: 'Add excited.live to Cursor:\n\nIn ~/.cursor/mcp.json, add:\n{\n  "mcpServers": {\n    "excited": { "url": "' + MCP_URL + '" }\n  }\n}\n\nRestart Cursor, then use the onboard_me prompt and follow its guide. Your client will ask you to sign in to excited.live. Talk to me in English.',
