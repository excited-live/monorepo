              },
              claude: {
                prompt: 'Add excited.live to Claude:\n\nSettings → Connectors → Add custom connector:\n' + MCP_URL + '\n\nThen use the onboard_me prompt and follow its guide. Your client will ask you to sign in to excited.live. Talk to me in English.',
