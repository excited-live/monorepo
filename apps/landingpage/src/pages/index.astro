.states-strip { background-color: var(--lifted); border-top: 2px dashed var(--border); padding: 48px 24px 64px; }
.states-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 24px 0; }
.state-frame { background-color: var(--canvas); border: 1px solid var(--border); border-radius: 24px; padding: 24px; }
.state-mock-snippet { background-color: var(--white); border: 1px solid var(--border-soft); border-radius: 16px; padding: 14px; font-size: 13px; margin-top: 10px; }
.btn-disabled { background-color: var(--border); color: var(--slate); border-radius: var(--btn-radius); padding: 6px 14px; font-size: 13px; font-weight: 500; display: inline-block; margin-top: 8px; }
.copy-fallback-area { width: 100%; margin-top: 12px; padding: 10px; font-family: var(--font-mono); font-size: 12px; border-radius: 12px; border: 1px solid var(--ink); background: var(--white); display: none; }

          /* Living Capabilities Animation Suite (All 5 Cards Alive) */
          /* Card 1: Ask (Chat Stream & Dialogue Float) */
          .b-chat .b-bubble:nth-child(1) {
            animation: chatFloat1 5s ease-in-out infinite alternate;
          }
          .b-chat .b-bubble:nth-child(2) {
            animation: chatFloat2 5s ease-in-out infinite alternate 0.3s;
          }
          .b-chat .b-bubble:nth-child(3) {
            animation: chatFloat3 5s ease-in-out infinite alternate 0.6s;
          }
          .b-chat .b-bubble--agent {
            animation: agentStreamPulse 4s ease-in-out infinite alternate;
          }
          @keyframes chatFloat1 {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
          }
          @keyframes chatFloat2 {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-2px); }
          }
          @keyframes chatFloat3 {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-4px); }
          }
          @keyframes agentStreamPulse {
            0%, 100% { border-color: var(--border-soft); box-shadow: none; }
            50% { border-color: rgba(207, 69, 0, 0.38); box-shadow: 0 4px 12px rgba(207, 69, 0, 0.08); }
          }

          /* Card 2: What-if (Active Monte Carlo Computation & Terminal Scan) */
          .b-terminal {
            position: relative;
          }
          .b-terminal::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 0%, rgba(243, 115, 56, 0.05) 50%, transparent 100%);
            pointer-events: none;
            animation: terminalScan 5s linear infinite;
          }
          .b-term-meta {
            animation: termMetaPulse 3.2s ease-in-out infinite alternate;
          }
          .b-term-value {
            animation: termValueBreathe 4s ease-in-out infinite alternate;
          }
          .b-term-ok {
            animation: termOkGlow 3.6s ease-in-out infinite alternate;
          }
          @keyframes terminalScan {
            0% { transform: translateY(-100%); opacity: 0; }
            30% { opacity: 1; }
            70% { opacity: 1; }
            100% { transform: translateY(100%); opacity: 0; }
          }
          @keyframes termMetaPulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 0.95; color: var(--orange-light); }
          }
          @keyframes termValueBreathe {
            0%, 100% { color: var(--canvas); }
            50% { color: #f37338; }
          }
          @keyframes termOkGlow {
            0%, 100% { opacity: 0.85; filter: drop-shadow(0 0 0 transparent); }
            50% { opacity: 1; filter: drop-shadow(0 0 6px rgba(243, 115, 56, 0.65)); }
          }

          /* Card 3: Log (Active Accounting Bot & Ledger Toast) */
          .b-bot-avatar {
            animation: botAvatarPulse 3.5s ease-in-out infinite;
          }
          .b-bot .b-bubble--user {
            animation: logFloatUser 5s ease-in-out infinite alternate;
          }
          .b-bot-row {
            animation: logFloatAgent 5s ease-in-out infinite alternate 0.4s;
          }
          .b-bot .b-bubble--agent {
            border-left: 2px solid var(--orange);
            animation: logHighlight 4.5s ease-in-out infinite alternate;
          }
          @keyframes botAvatarPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(20, 20, 19, 0.2); }
            50% { transform: scale(1.08); box-shadow: 0 0 0 5px rgba(207, 69, 0, 0.16); }
          }
          @keyframes logFloatUser {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
          }
          @keyframes logFloatAgent {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-2px); }
          }
          @keyframes logHighlight {
            0%, 100% { border-left-color: var(--orange); }
