	<script is:inline data-astro-rerun>
		// Pure-CSS bilingual toggle: flips <html data-lang>, persists to localStorage.
		document.addEventListener('click', function (event) {
			const target = event.target.closest('[data-set-lang]');
			if (!target) return;
			const lang = target.getAttribute('data-set-lang');
			document.documentElement.dataset.lang = lang;
			try {
				localStorage.setItem('exl-lang', lang);
			} catch {
				/* private mode — toggle still works for this page view */
			}
		});
	</script>

	<script is:inline data-astro-rerun>
		// Before / after switch. Markup ships in the "after" state so the section is
		// complete without JS; on load we rewind to "before", then play the reveal
		// once when the section scrolls into view (unless the visitor already clicked).
		(function () {
			var stage = document.querySelector('.chaos');
			var buttons = document.querySelectorAll('.switch-btn');
			if (!stage || !buttons.length) return;
			var touched = false;
			var reduce = false;
			try {
				reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			} catch (e) { /* very old browsers: animation is fine */ }

			function setView(view) {
				stage.setAttribute('data-state', view);
				buttons.forEach(function (b) {
					b.setAttribute('aria-pressed', String(b.getAttribute('data-view') === view));
				});
			}

			buttons.forEach(function (b) {
				b.addEventListener('click', function () {
					touched = true;
					setView(b.getAttribute('data-view'));
				});
			});

			if (reduce || !('IntersectionObserver' in window)) return;
			setView('before');
			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						if (!entry.isIntersecting) return;
						observer.disconnect();
						setTimeout(function () {
							if (!touched) setView('after');
						}, 1600);
					});
				},
				{ threshold: 0.5 }
			);
			observer.observe(stage);
		})();
	</script>

	<!-- ============ MOTION (OpenDesign pass — spec in src/styles/landing-motion.css) ============ -->
	<script is:inline data-astro-rerun>
		(function () {
			var root = document.documentElement;
			if (!root.classList.contains('motion')) return;

			var reduce = false;
			try {
				reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			} catch (e) {}
			if (reduce) {
				root.classList.remove('motion');
				return;
			}

			var rAF = window.requestAnimationFrame || function (fn) { return setTimeout(fn, 16); };

			/* --- 1. hero choreography: two frames so the masks set first --- */
			var hero = document.querySelector('.hero');
			if (hero) {
				rAF(function () {
					rAF(function () {
						hero.classList.add('is-loaded');
					});
				});
			}

			/* --- 2. reveal tagging: markup stays clean, stagger lives here --- */
			var groups = [
				['.section-head', ':scope > *', 70],
				['.bento', ':scope > .bento-card', 70],
				['.orbit-stage', ':scope > .orbit-item', 180],
				['.next-grid', ':scope > .next-card', 80],
				['.perk-cards', ':scope > .perk-card', 80],
				['.deeper', ':scope > *', 90]
			];
			var targets = [];
			groups.forEach(function (g) {
				var parents = document.querySelectorAll(g[0]);
				Array.prototype.forEach.call(parents, function (parent) {
					Array.prototype.forEach.call(parent.querySelectorAll(g[1]), function (el, i) {
						if (el.hasAttribute('data-reveal')) return;
						el.setAttribute('data-reveal', '');
						el.style.setProperty('--d', String(Math.min(i, 6) * g[2]));
						targets.push(el);
					});
				});
			});

			if ('IntersectionObserver' in window) {
				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (entry) {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
				);
				targets.forEach(function (t) {
					io.observe(t);
				});
			} else {
				targets.forEach(function (t) {
					t.classList.add('is-in');
				});
			}

			/* --- 3. orbit arcs draw themselves, once --- */
			Array.prototype.forEach.call(
				document.querySelectorAll('.hero-orbit path, .orbit-svg path'),
				function (path) {
					if (typeof path.getTotalLength !== 'function') return;
					var len = path.getTotalLength();
					path.style.strokeDasharray = len;
					path.style.strokeDashoffset = len;
					var go = function () {
						path.style.strokeDashoffset = '0';
					};
					if (!('IntersectionObserver' in window)) return go();
					var o = new IntersectionObserver(
						function (entries) {
							if (!entries[0].isIntersecting) return;
							o.disconnect();
							setTimeout(go, 120);
						},
						{ threshold: 0.15 }
					);
					o.observe(path);
				}
			);

			/* --- 4. one rAF pointer parallax on the hero visual (desktop only) --- */
			var visual = document.querySelector('.hero-visual');
			var fine = false;
			try {
				fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
			} catch (e) {}
			if (visual && hero && fine) {
				var tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
				var loop = function () {
					cx += (tx - cx) * 0.12;
					cy += (ty - cy) * 0.12;
					visual.style.transform = 'translate3d(' + cx.toFixed(2) + 'px,' + cy.toFixed(2) + 'px,0)';
					if (Math.abs(tx - cx) > 0.1 || Math.abs(ty - cy) > 0.1) {
						raf = rAF(loop);
					} else {
						raf = 0;
					}
				};
				hero.addEventListener(
					'pointermove',
					function (e) {
						var r = hero.getBoundingClientRect();
						tx = ((e.clientX - r.left) / r.width - 0.5) * 16;
						ty = ((e.clientY - r.top) / r.height - 0.5) * 12;
						if (!raf) raf = rAF(loop);
					},
					{ passive: true }
				);
			}

			/* --- 5. counters: runway chip + consolidated total --- */
			function countUp(el, target, prefix, format) {
				var t0 = 0;
				var step = function (ts) {
					if (!t0) t0 = ts;
					var p = Math.min((ts - t0) / 900, 1);
					var value = target * (1 - Math.pow(1 - p, 3));
					el.textContent = prefix + format(Math.round(value));
					if (p < 1) {
						rAF(step);
					} else {
						el.textContent = prefix + format(target);
					}
				};
				rAF(step);
			}

			Array.prototype.forEach.call(document.querySelectorAll('[data-count]'), function (el) {
				var target = parseFloat(el.getAttribute('data-count')) || 0;
				el.textContent = '0';
				if (!('IntersectionObserver' in window)) {
					el.textContent = String(target);
					return;
				}
				var o = new IntersectionObserver(
					function (entries) {
						if (!entries[0].isIntersecting) return;
						o.disconnect();
						countUp(el, target, '', function (n) {
							return String(n);
						});
					},
					{ threshold: 0.4 }
				);
				o.observe(el);
			});

			Array.prototype.forEach.call(document.querySelectorAll('[data-odometer]'), function (el) {
				var target = parseFloat(el.getAttribute('data-odometer')) || 0;
				el.textContent = '฿0';
				if (!('IntersectionObserver' in window)) {
					el.textContent = '฿' + target.toLocaleString('en-US');
					return;
				}
				var o = new IntersectionObserver(
					function (entries) {
						if (!entries[0].isIntersecting) return;
						o.disconnect();
						countUp(el, target, '฿', function (n) {
							return n.toLocaleString('en-US');
						});
					},
					{ threshold: 0.4 }
				);
				o.observe(el);
			});

			/* --- 6. nav condense on scroll, hide on the way down --- */
			var nav = document.querySelector('.nav-wrap');
			if (nav) {
				var last = window.scrollY || 0;
				var ticking = false;
				var onScroll = function () {
					var y = window.scrollY || 0;
					nav.classList.toggle('is-condensed', y > 80);
					if (y > 180 && y > last + 6) {
						nav.classList.add('is-hidden');
					} else if (y < last - 6 || y < 180) {
						nav.classList.remove('is-hidden');
					}
					last = y;
					ticking = false;
				};
				window.addEventListener(
					'scroll',
					function () {
						if (ticking) return;
						ticking = true;
						rAF(onScroll);
					},
					{ passive: true }
				);
				onScroll();
			}

			/* --- 7. bento spotlight follows the pointer, desktop only --- */
			if (fine) {
				Array.prototype.forEach.call(document.querySelectorAll('.bento-card'), function (card) {
					card.addEventListener(
						'pointermove',
						function (e) {
							var r = card.getBoundingClientRect();
							card.style.setProperty('--mx', e.clientX - r.left + 'px');
							card.style.setProperty('--my', e.clientY - r.top + 'px');
						},
						{ passive: true }
					);
				});
			}
		})();
	</script>
</Layout>
