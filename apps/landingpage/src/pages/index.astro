---
import Layout from '@/components/layout.astro';
import WaitlistForm from '@/components/WaitlistForm';
import LangSelect from '@/components/LangSelect';

const title = 'excited.live — Plan the life you want to live';
const description =
	'Simulate your money and life plans before you live them. Tax, expenses, and future scenarios — free for everyone. Join the waitlist.';
---

<Layout title={title} description={description}>
	<!-- ============ NAV ============ -->
	<div class="nav-wrap">
		<nav class="nav-pill" aria-label="Main">
			<a class="nav-brand" href="/" aria-label="excited.live">
				<img src="/logo-mark.png" alt="" width="28" height="28" />
				<span>excited<span class="brand-dot">.live</span></span>
			</a>
			<div class="nav-links">
				<a href="#what">
					<span data-lang-en>What is it</span>
					<span data-lang-th>มันคืออะไร</span>
				</a>
				<a href="#perks">
					<span data-lang-en>Why join</span>
					<span data-lang-th>ทำไมต้องลง</span>
				</a>
				<a href="/blog">
					<span data-lang-en>Blog</span>
					<span data-lang-th>บล็อก</span>
				</a>
				<a href="/docs">
					<span data-lang-en>Docs</span>
					<span data-lang-th>เอกสาร</span>
				</a>
			</div>
			<div class="nav-actions">
				<LangSelect client:load />
				<a class="btn-ink" href="#waitlist">
					<span data-lang-en>Join waitlist</span>
					<span data-lang-th>ลงทะเบียน</span>
				</a>
			</div>
		</nav>
	</div>

	<!-- ============ HERO ============ -->
	<header class="hero" id="waitlist">
		<div class="hero-graph" aria-hidden="true">
			<svg viewBox="0 0 460 340">
				<g class="grid">
					<line x1="20" y1="70" x2="440" y2="70" />
					<line x1="20" y1="145" x2="440" y2="145" />
					<line x1="20" y1="220" x2="440" y2="220" />
					<line x1="20" y1="295" x2="440" y2="295" />
				</g>
				<path
					class="area"
					d="M20 295 C 90 288, 150 262, 200 240 C 260 214, 300 175, 350 140 C 385 115, 415 85, 440 62 L440 295 Z"
				/>
				<path
					class="line-proj"
					d="M20 295 C 110 282, 200 262, 290 252 C 350 245, 405 240, 440 236"
				/>
				<path
					class="line-main"
					d="M20 295 C 90 288, 150 262, 200 240 C 260 214, 300 175, 350 140 C 385 115, 415 85, 440 62"
				/>
				<circle class="dot-halo" cx="440" cy="62" r="13" />
				<circle class="dot" cx="440" cy="62" r="6" />
				<text class="axis" x="20" y="322">2026</text>
				<text class="axis" x="400" y="322">2036</text>
			</svg>
			<span class="hero-chip chip-goal">
				<span data-lang-en>Buy a condo · 2031</span>
				<span data-lang-th>ซื้อคอนโด · 2031</span>
			</span>
			<span class="hero-chip chip-reached">
				<span data-lang-en>Goal reached ✓</span>
				<span data-lang-th>ถึงเป้าหมาย ✓</span>
			</span>
		</div>
		<div class="hero-inner">
			<p class="eyebrow">
				<span data-lang-en>Coming soon</span>
				<span data-lang-th>เร็ว ๆ นี้</span>
			</p>
			<h1>
				<span data-lang-en>Plan the life<br />you want to <span class="accent">live</span></span>
				<span data-lang-th>วางแผนชีวิตแบบ<br />ที่คุณอยาก<span class="accent">ใช้ชีวิต</span></span>
			</h1>
			<p class="hero-sub">
				<span data-lang-en>
					Simulate your money and your plans before you live them — tax, expenses, and life
					goals. Free for everyone.
				</span>
				<span data-lang-th>
					จำลองการเงินและแผนชีวิตของคุณก่อนใช้จริง — ภาษี ค่าใช้จ่าย และเป้าหมายต่าง ๆ
					ฟรีสำหรับทุกคน
				</span>
			</p>
			<div class="hero-perks">
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Battle-tested math</span>
					<span data-lang-th>คณิตที่พิสูจน์แล้ว</span>
