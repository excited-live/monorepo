	<script is:inline>
		// Product links on a preview or prelive host must point at the prelive
		// webapp, never production: a preview must not create a real account.
		(() => {
			const host = location.hostname;
			if (host === 'excited.live' || host === 'www.excited.live') return;
			document.querySelectorAll('[data-app-link]').forEach((el) => {
				const path = el.getAttribute('data-app-link');
				if (path) el.setAttribute('href', 'https://prelive.excited.live' + path);
			});
		})();
