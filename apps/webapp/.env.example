# API runtime mode: "mock" (default, zero backend calls) or "live" (connects to backend)
VITE_API_MODE=mock

# Backend API server URL (used in live mode / dev:api proxy)
BACKEND_API_URL=http://localhost:8000

# Better Auth (docs/plan-auth-migration.md). Staging values live in GitHub repo
# secrets / your local .env only. NEVER commit .env.
# Min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
# Optional: fixed deployment origin (issuer/trusted origins). Leave unset to
# derive the origin per request (correct for PR preview deployments).
BETTER_AUTH_URL=
# Optional Google social login (OQ-1); auth works without them (email/password only)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Local dev auth database (node:sqlite), used when no D1 binding is present.
# Defaults to .data/auth.sqlite relative to apps/webapp.
EXCITED_WEBAPP_AUTH_DB=
# MCP sign-in link (A2): the public API origin. With BETTER_AUTH_URL set, the
# webapp becomes the OAuth 2.1 authorization server for <EXCITED_API_URL>/mcp
# (dynamic client registration + device flow). Leave unset to keep auth as-is.
EXCITED_API_URL=
# Route gate: require sign-in for app pages ("true" or "1"). Production only —
# leave unset on prelive/previews/local so the app stays browsable without auth.
# (Renamed from WORKOS_REQUIRE_AUTH in the Better Auth migration.)
AUTH_REQUIRED=
