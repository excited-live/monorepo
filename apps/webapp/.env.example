# API runtime mode: "mock" (default, zero backend calls) or "live" (connects to backend)
VITE_API_MODE=mock

# Backend API server URL (used in live mode / dev:api proxy)
BACKEND_API_URL=http://localhost:8000

# WorkOS AuthKit (staging keys live in GitHub repo secrets / your local .env only)
# Copy this file to .env and fill in real values. NEVER commit .env.
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match a Redirect URI configured in the WorkOS dashboard
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Min 32 chars. Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=replace-me-with-at-least-32-characters

# Optional: require sign-in for app routes ("true" or "1"). Production only —
# leave unset on prelive/previews/local so the app stays browsable without auth.
WORKOS_REQUIRE_AUTH=

# Better Auth (foundation for the WorkOS→Better Auth migration, docs/plan-auth-migration.md).
# Staging values live in GitHub repo secrets / your local .env only. NEVER commit .env.
# Min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
# The deployment origin Better Auth derives its issuer/trusted origins from
BETTER_AUTH_URL=http://localhost:3000
# Optional Google social login (OQ-1); auth works without them (email/password only)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
