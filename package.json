{
	"name": "excited-live",
	"private": true,
	"packageManager": "pnpm@10.12.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check:skills": "bash ./scripts/check-skills.sh",
		"dev": "turbo run dev",
		"dev:api": "turbo run dev:api",
		"lint": "eslint .",
		"start": "turbo run start",
		"sync:skills": "bash ./scripts/sync-skills.sh",
		"test": "turbo run test",
		"test:visual": "pnpm --filter @excited-live/webapp test:visual",
		"test:visual:update": "pnpm --filter @excited-live/webapp test:visual:update",
		"test:visual:mobile": "pnpm --filter @excited-live/biz-mobile test:visual",
		"test:visual:mobile:update": "pnpm --filter @excited-live/biz-mobile test:visual:update",
		"capture:landing": "pnpm --filter @excited-live/biz-mobile capture:landing && pnpm --filter @excited-live/landingpage optimize:shots",
		"typecheck": "turbo run typecheck"
	},
	"dependencies": {
		"turbo": "^2.10.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript-eslint": "^8.68.0"
	}
}
