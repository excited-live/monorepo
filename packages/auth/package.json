{
	"name": "@excited-live/auth",
	"version": "0.0.1",
	"description": "Shared Better Auth instance factory for excited.live (webapp cookies + API tokens)",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"require": "./dist/client.cjs"
		},
		"./tanstack-start": {
			"types": "./dist/tanstack-start.d.ts",
			"import": "./dist/tanstack-start.js",
			"require": "./dist/tanstack-start.cjs"
		},
		"./flow": {
			"types": "./dist/flow.d.ts",
			"import": "./dist/flow.js",
			"require": "./dist/flow.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"gen:schema": "tsx scripts/gen-schema.ts"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.7",
		"@better-auth/kysely-adapter": "1.7.7",
		"@better-auth/oauth-provider": "1.7.7",
		"@excited-live/http": "workspace:*",
		"better-auth": "^1.3.0",
		"kysely": "^0.28.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsup": "catalog:",
		"tsx": "^4.19.3",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
