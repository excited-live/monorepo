{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"PORT",
		"VITE_API_MODE",
		"BACKEND_API_URL",
		"WORKOS_CLIENT_ID",
		"WORKOS_API_KEY",
		"WORKOS_REDIRECT_URI",
		"WORKOS_COOKIE_PASSWORD",
		"WORKOS_REQUIRE_AUTH",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"BETTER_AUTH_GOOGLE_CLIENT_ID",
		"BETTER_AUTH_GOOGLE_CLIENT_SECRET"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:api": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
